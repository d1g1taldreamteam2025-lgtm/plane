---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Nosotros" description="Conoce a Family Key Auto Group: concesionario familiar centrado en el cliente, precios honestos, vehículos inspeccionados y financiamiento confiable.">
  <div class="fkag-ab-page">
    <section class="fkag-ab-hero">
      <div class="fkag-container">
        <h1 data-i18n="about_title">About Family Key Auto Group</h1>
        <p data-i18n="about_hero_sub">For over a decade, we've been helping families find quality vehicles with honest pricing and trusted financing — one key at a time.</p>
      </div>
    </section>

    <section class="fkag-sect">
      <div class="fkag-container">
        <div class="fkag-2col">
          <div class="fkag-img-wrap"><img src="/images/about-story.png" alt="Family Key Auto Group" loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.svg';"></div>
          <div>
            <p class="fkag-h-eyebrow"><span data-i18n="about_eyebrow">Our Story</span></p>
            <h2 class="fkag-h2" data-i18n="about_subtitle">Family-owned, customer-first since 2014.</h2>
            <p class="fkag-p" data-i18n="about_p1">Family Key Auto Group started with a simple promise: treat every customer the way we'd treat our own family. What began as a small lot with a handful of carefully chosen vehicles has grown into one of the most trusted independent dealerships in the area.</p>
            <p class="fkag-p" data-i18n="about_p2">We don't believe in pushy sales tactics or hidden fees. Every car on our lot is hand-picked, fully inspected, and priced honestly — because we know buying a car is about more than just the deal. It's about getting your family where they need to go, safely and reliably.</p>
          </div>
        </div>
        <div class="fkag-stats">
          <div class="fkag-stat"><div class="fkag-stat-num">10+</div><div class="fkag-stat-lab"><span data-i18n="stat_years">Years in Business</span></div></div>
          <div class="fkag-stat"><div class="fkag-stat-num">5,000+</div><div class="fkag-stat-lab"><span data-i18n="stat_families">Happy Families</span></div></div>
          <div class="fkag-stat"><div class="fkag-stat-num">4.9 <svg viewBox="0 0 24 24" fill="#c9a961" width="22" height="22"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div><div class="fkag-stat-lab"><span data-i18n="stat_rating">Average Rating</span></div></div>
          <div class="fkag-stat"><div class="fkag-stat-num">100%</div><div class="fkag-stat-lab"><span data-i18n="stat_inventory">Inspected Inventory</span></div></div>
        </div>
      </div>
    </section>

    <section class="fkag-sect fkag-sect-soft">
      <div class="fkag-container">
        <div class="fkag-ab-head">
          <p class="fkag-h-eyebrow"><span data-i18n="values_eyebrow">Our Values</span></p>
          <h2 class="fkag-h2" data-i18n="values_title">What we stand for, every single day.</h2>
          <p class="fkag-p" data-i18n="values_sub">Three principles guide every interaction, every vehicle, and every deal we make.</p>
        </div>
        <div class="fkag-vals">
          <div class="fkag-val">
            <div class="fkag-value__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="40" height="40"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <h3 data-i18n="value_honesty_title">Honesty First</h3>
            <p data-i18n="value_honesty_sub">Transparent pricing, full vehicle history, and no surprise fees. The price you see is the price you pay.</p>
          </div>
          <div class="fkag-val">
            <div class="fkag-value__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="40" height="40"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
            <h3 data-i18n="value_quality_title">Quality You Trust</h3>
            <p data-i18n="value_quality_sub">Every vehicle passes a rigorous multi-point inspection before it ever reaches our lot. If we wouldn't drive it, we won't sell it.</p>
          </div>
          <div class="fkag-val">
            <div class="fkag-value__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="40" height="40"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            <h3 data-i18n="value_family_title">Family Treatment</h3>
            <p data-i18n="value_family_sub">We're not transactional. We build relationships that last beyond the sale, with support and guidance whenever you need it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="fkag-ab-cta">
      <div class="fkag-container">
        <h2 data-i18n="about_cta_title">Ready to find your next car?</h2>
        <p data-i18n="about_cta_sub">Browse our inventory or get pre-qualified today. Our team is ready to help you drive home happy.</p>
        <div class="fkag-cta-btns">
          <a href="/inventory/" class="fkag-btn fkag-btn-pri"><span data-i18n="cta_browse_inventory">Browse Inventory</span></a>
          <a href="/financing/apply/" class="fkag-btn fkag-btn-out"><span data-i18n="cta_prequalify">Get Pre-Qualified</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  (function () {
    var LANG = (function () { try { var x = localStorage.getItem('fkag_lang'); return (x === 'en' || x === 'es') ? x : 'es'; } catch (e) { return 'es'; } })();
    var TR = {
      about_title:         { en: 'About Family Key Auto Group', es: 'Acerca de Family Key Auto Group' },
      about_hero_sub:      { en: "For over a decade, we've been helping families find quality vehicles with honest pricing and trusted financing — one key at a time.", es: 'Por más de una década, hemos ayudado a familias a encontrar vehículos de calidad con precios honestos y financiamiento confiable — una llave a la vez.' },
      about_eyebrow:       { en: 'Our Story', es: 'Nuestra Historia' },
      about_subtitle:      { en: 'Family-owned, customer-first since 2014.', es: 'Negocio familiar, centrado en el cliente desde 2014.' },
      about_p1:            { en: "Family Key Auto Group started with a simple promise: treat every customer the way we'd treat our own family. What began as a small lot with a handful of carefully chosen vehicles has grown into one of the most trusted independent dealerships in the area.", es: 'Family Key Auto Group nació con una promesa simple: tratar a cada cliente como tratamos a nuestra propia familia. Lo que empezó como un pequeño lote con unos pocos vehículos cuidadosamente seleccionados, se convirtió en uno de los concesionarios independientes más confiables de la zona.' },
      about_p2:            { en: "We don't believe in pushy sales tactics or hidden fees. Every car on our lot is hand-picked, fully inspected, and priced honestly — because we know buying a car is about more than just the deal. It's about getting your family where they need to go, safely and reliably.", es: 'No creemos en tácticas de venta agresivas ni cargos ocultos. Cada carro está seleccionado a mano, completamente inspeccionado y con precio honesto — porque comprar un carro va más allá del trato. Se trata de llevar a tu familia adonde necesite ir, de forma segura y confiable.' },
      stat_years:          { en: 'Years in Business', es: 'Años en el Negocio' },
      stat_families:       { en: 'Happy Families', es: 'Familias Felices' },
      stat_rating:         { en: 'Average Rating', es: 'Calificación Promedio' },
      stat_inventory:      { en: 'Inspected Inventory', es: 'Inventario Inspeccionado' },
      values_eyebrow:      { en: 'Our Values', es: 'Nuestros Valores' },
      values_title:        { en: 'What we stand for, every single day.', es: 'Lo que defendemos, cada día.' },
      values_sub:          { en: 'Three principles guide every interaction, every vehicle, and every deal we make.', es: 'Tres principios guían cada interacción, cada vehículo y cada trato que hacemos.' },
      value_honesty_title: { en: 'Honesty First', es: 'Honestidad Primero' },
      value_honesty_sub:   { en: 'Transparent pricing, full vehicle history, and no surprise fees. The price you see is the price you pay.', es: 'Precios transparentes, historial completo del vehículo, sin cargos sorpresa. El precio que ves es el precio que pagas.' },
      value_quality_title: { en: 'Quality You Trust', es: 'Calidad de Confianza' },
      value_quality_sub:   { en: "Every vehicle passes a rigorous multi-point inspection before it ever reaches our lot. If we wouldn't drive it, we won't sell it.", es: 'Cada vehículo pasa una rigurosa inspección de múltiples puntos antes de llegar a nuestro lote. Si no lo manejaríamos, no lo vendemos.' },
      value_family_title:  { en: 'Family Treatment', es: 'Trato Familiar' },
      value_family_sub:    { en: "We're not transactional. We build relationships that last beyond the sale, with support and guidance whenever you need it.", es: 'No somos transaccionales. Construimos relaciones que duran más allá de la venta, con apoyo y guía cuando lo necesites.' },
      about_cta_title:     { en: 'Ready to find your next car?', es: '¿Listo para encontrar tu próximo carro?' },
      about_cta_sub:       { en: 'Browse our inventory or get pre-qualified today. Our team is ready to help you drive home happy.', es: 'Explora nuestro inventario o pre-califica hoy. Nuestro equipo está listo para ayudarte a llegar a casa feliz.' },
      cta_browse_inventory:{ en: 'Browse Inventory', es: 'Ver Inventario' },
      cta_prequalify:      { en: 'Get Pre-Qualified', es: 'Pre-Calificar' }
    };
    function t(k) { return TR[k] ? (TR[k][LANG] || TR[k].en) : k; }
    function applyTr() {
      document.querySelectorAll('.fkag-ab-page [data-i18n]').forEach(function (el) {
        var k = el.getAttribute('data-i18n');
        if (TR[k]) el.innerHTML = t(k);
      });
    }
    applyTr();
    window.addEventListener('fkag-lang-change', function (e) {
      var nl = (e.detail && e.detail.lang) || LANG;
      if (nl === LANG) return;
      LANG = nl;
      applyTr();
    });
  })();
</script>

<style>
  .fkag-ab-page { width: 100%; }
  .fkag-ab-hero { background: linear-gradient(135deg, #0c0c0c 0%, #1a1a1a 100%); color: #fff; padding: 96px 0; text-align: center; }
  .fkag-ab-hero h1 { font-family: 'Poppins', sans-serif; font-size: 48px; font-weight: 800; margin: 0 0 16px; letter-spacing: -1px; color: #fff; }
  .fkag-ab-hero p { font-size: 18px; color: rgba(255, 255, 255, 0.92); margin: 0 auto; max-width: 680px; line-height: 1.7; }
  @media (max-width: 768px) { .fkag-ab-hero { padding: 70px 0; } .fkag-ab-hero h1 { font-size: 34px; } .fkag-ab-hero p { font-size: 16px; } }
  .fkag-sect { padding: 80px 0; background: #fff; }
  .fkag-sect-soft { background: #f5f7fa; }
  .fkag-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  @media (max-width: 900px) { .fkag-2col { grid-template-columns: 1fr; gap: 36px; } }
  .fkag-h-eyebrow { color: #c9a961; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 12px; }
  .fkag-h2 { font-family: 'Poppins', sans-serif; font-size: 36px; font-weight: 800; color: #0a0a0a; margin: 0 0 18px; letter-spacing: -0.5px; line-height: 1.2; }
  .fkag-p { font-size: 16px; color: #475569; line-height: 1.75; margin: 0 0 16px; }
  .fkag-img-wrap { border-radius: 12px; overflow: hidden; box-shadow: 0 18px 50px rgba(10, 10, 10, 0.15); }
  .fkag-img-wrap img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4/3; display: block; background: #eef2f7; }
  .fkag-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 48px; }
  @media (max-width: 768px) { .fkag-stats { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  .fkag-stat { text-align: center; }
  .fkag-stat-num { font-family: 'Poppins', sans-serif; font-size: 42px; font-weight: 800; color: #a88a47; line-height: 1; margin: 0 0 8px; display: inline-flex; align-items: center; gap: 4px; }
  .fkag-stat-lab { font-size: 14px; color: #5b6a7e; letter-spacing: 0.4px; }
  .fkag-ab-head { text-align: center; max-width: 620px; margin: 0 auto; }
  .fkag-vals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 48px; }
  @media (max-width: 900px) { .fkag-vals { grid-template-columns: 1fr; } }
  .fkag-val { background: #fff; padding: 32px; border-radius: 12px; border: 1px solid #e3e8ef; transition: 0.25s; }
  .fkag-val:hover { transform: translateY(-4px); box-shadow: 0 14px 36px rgba(10, 10, 10, 0.1); border-color: #c9a961; }
  .fkag-value__icon { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #fdf6e3 0%, #f5efe1 100%); color: #a88a47; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; border: 2px solid #c9a961; box-shadow: 0 4px 12px rgba(201, 169, 97, 0.2); }
  .fkag-value__icon svg { stroke: #a88a47; }
  .fkag-val h3 { font-family: 'Poppins', sans-serif; font-size: 18px; font-weight: 700; margin: 0 0 10px; color: #0a0a0a; }
  .fkag-val p { font-size: 14px; color: #5b6a7e; line-height: 1.7; margin: 0; }
  .fkag-ab-cta { background: #0c0c0c; color: #fff; padding: 72px 0; text-align: center; }
  .fkag-ab-cta h2 { font-family: 'Poppins', sans-serif; font-size: 34px; font-weight: 800; margin: 0 0 14px; color: #fff; }
  .fkag-ab-cta p { font-size: 16px; color: rgba(255, 255, 255, 0.9); margin: 0 auto 28px; max-width: 580px; }
  .fkag-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .fkag-btn { padding: 14px 30px; border-radius: 8px; font-weight: 700; font-size: 15px; display: inline-block; transition: 0.2s; text-decoration: none; }
  .fkag-btn-pri { background: #c9a961; color: #0c0c0c; }
  .fkag-btn-pri:hover { background: #a88a47; color: #fff; transform: translateY(-2px); }
  .fkag-btn-out { background: transparent; color: #fff; border: 2px solid #fff; }
  .fkag-btn-out:hover { background: #fff; color: #0c0c0c; }
  @media (max-width: 768px) { .fkag-ab-cta h2 { font-size: 26px; } .fkag-sect { padding: 60px 0; } }
</style>
