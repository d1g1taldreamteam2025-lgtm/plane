---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Aplicar para Financiamiento" description="Completa tu aplicación de crédito con Family Key Auto Group. Información cifrada, revisada en 1 día hábil.">
  <section class="fkag fkag-apply">
    <div class="fkag-apply__inner">
      <div class="fkag-apply__head">
        <span class="fkag-apply__eyebrow" data-i18n="apply_eyebrow">CREDIT APPLICATION</span>
        <h1 data-i18n="apply_title">Apply for Financing</h1>
        <p data-i18n="apply_sub">Complete the form below to start your pre-qualification. All information is securely encrypted and reviewed by our team within 1 business day.</p>
      </div>
      <form class="fkag-apply__form" id="fkagApplyForm" novalidate>
        <div class="fkag-apply__section">
          <h3 data-i18n="apply_s1_title">Personal Information</h3>
          <div class="fkag-apply__grid">
            <div class="fkag-field"><label data-i18n="apply_license">License ID</label><input type="text" id="license_id" name="license_id" required></div>
            <div class="fkag-field"><label data-i18n="apply_fname">First Name</label><input type="text" id="first_name" name="first_name" required></div>
            <div class="fkag-field"><label data-i18n="apply_lname">Last Name</label><input type="text" id="last_name" name="last_name" required></div>
            <div class="fkag-field"><label data-i18n="apply_phone">Phone Number</label><input type="tel" id="phone" name="phone" required></div>
            <div class="fkag-field"><label data-i18n="apply_email">Email</label><input type="email" id="email" name="email" required></div>
            <div class="fkag-field"><label data-i18n="apply_dob">Date of Birth</label><input type="date" id="dob" name="dob" required></div>
            <div class="fkag-field fkag-field--full"><label data-i18n="apply_ssn">Social Security or ITIN (optional but speeds up approval)</label><input type="text" id="ssn_itin" name="ssn_itin"></div>
          </div>
        </div>
        <div class="fkag-apply__section">
          <h3 data-i18n="apply_s2_title">Address</h3>
          <div class="fkag-apply__grid">
            <div class="fkag-field fkag-field--full"><label data-i18n="apply_address">Address</label><input type="text" id="address" name="address" required></div>
            <div class="fkag-field"><label data-i18n="apply_state">State</label><select id="state" name="state" required>
              <option value="">--</option>
              <option>CA</option><option>AZ</option><option>NV</option><option>TX</option><option>FL</option><option>NY</option><option>GA</option><option>NC</option><option>OR</option><option>WA</option>
            </select></div>
            <div class="fkag-field"><label data-i18n="apply_city">City</label><input type="text" id="city" name="city" required></div>
            <div class="fkag-field"><label data-i18n="apply_zip">Zip Code</label><input type="text" id="zip" name="zip" required></div>
            <div class="fkag-field fkag-field--full"><label data-i18n="apply_residence_time">How long have you lived at this address?</label><input type="text" id="residence_time" name="residence_time" data-i18n-placeholder="ph_residence" placeholder="e.g. 2 years"></div>
          </div>
        </div>
        <div class="fkag-apply__section">
          <h3 data-i18n="apply_s3_title">Employment</h3>
          <div class="fkag-apply__grid">
            <div class="fkag-field"><label data-i18n="apply_employer">Present Employer</label><input type="text" id="employer" name="employer"></div>
            <div class="fkag-field"><label data-i18n="apply_employed_time">How long have you worked here?</label><input type="text" id="employed_time" name="employed_time"></div>
            <div class="fkag-field"><label data-i18n="apply_employer_phone">Employer Phone Number</label><input type="tel" id="employer_phone" name="employer_phone"></div>
            <div class="fkag-field"><label data-i18n="apply_occupation">Occupation</label><input type="text" id="occupation" name="occupation"></div>
            <div class="fkag-field fkag-field--full"><label data-i18n="apply_work_address">Work Address</label><input type="text" id="work_address" name="work_address"></div>
            <div class="fkag-field fkag-field--full"><label data-i18n="apply_self_employed">If self-employed, what do you do?</label><input type="text" id="self_employed_desc" name="self_employed_desc"></div>
            <div class="fkag-field"><label data-i18n="apply_pay_freq">You get paid per</label><select id="pay_frequency" name="pay_frequency">
              <option value="">--</option>
              <option value="weekly" data-i18n="apply_freq_weekly">Weekly</option>
              <option value="biweekly" data-i18n="apply_freq_biweekly">Bi-weekly</option>
              <option value="monthly" data-i18n="apply_freq_monthly">Monthly</option>
            </select></div>
            <div class="fkag-field"><label data-i18n="apply_gross">Gross Income (Monthly)</label><input type="number" id="gross_income" name="gross_income" placeholder="$"></div>
            <div class="fkag-field"><label data-i18n="apply_down">Down Payment</label><input type="number" id="down_payment" name="down_payment" placeholder="$"></div>
          </div>
        </div>
        <div class="fkag-apply__section">
          <h3 data-i18n="apply_s4_title">Authorization</h3>
          <div class="fkag-field fkag-field--full"><label data-i18n="apply_authorize">I authorize Family Key Auto Group to run and check my credit with the intention of getting an approval for a vehicle loan.</label>
            <select id="authorize" name="authorize" required>
              <option value="">--</option>
              <option value="yes" data-i18n="apply_yes">Yes</option>
              <option value="no" data-i18n="apply_no">No</option>
            </select></div>
          <div class="fkag-field fkag-field--full">
            <label data-i18n="apply_signature">Signature (initials)</label>
            <p class="fkag-field__hint"><span data-i18n="apply_signature_sub">By placing your initials you consent Family Key Auto Group to run your credit.</span></p>
            <input type="text" id="signature" name="signature" data-i18n-placeholder="ph_signature" placeholder="e.g. J.D." required maxlength="10">
          </div>
        </div>
        <div class="fkag-apply__section">
          <h3 data-i18n="apply_s5_title">Vehicle Trade Information (Optional)</h3>
          <div class="fkag-apply__grid">
            <div class="fkag-field"><label data-i18n="apply_make">Make</label><input type="text" id="trade_make" name="trade_make"></div>
            <div class="fkag-field"><label data-i18n="apply_model">Model</label><input type="text" id="trade_model" name="trade_model"></div>
            <div class="fkag-field"><label data-i18n="apply_year">Year</label><input type="number" id="trade_year" name="trade_year"></div>
            <div class="fkag-field"><label data-i18n="apply_miles">Miles</label><input type="number" id="trade_miles" name="trade_miles"></div>
            <div class="fkag-field"><label data-i18n="apply_vin">VIN</label><input type="text" id="trade_vin" name="trade_vin"></div>
            <div class="fkag-field"><label data-i18n="apply_balance">Balance Due</label><input type="number" id="trade_balance" name="trade_balance" placeholder="$"></div>
          </div>
        </div>
        <div class="fkag-apply__section">
          <div class="fkag-field fkag-field--full"><label data-i18n="apply_notes">Notes (optional)</label><textarea id="notes" name="notes" rows="4" placeholder=""></textarea></div>
        </div>
        <div class="fkag-apply__submit-wrap">
          <div class="fkag-sms-consent"><label class="fkag-sms-consent__label"><input type="checkbox" name="sms_consent" required><span class="fkag-sms-consent__text" data-i18n="sms_consent_text">By checking this box, I consent to receive SMS and calls from <strong>Family Key Auto Group</strong> regarding my inquiry about vehicles, financing, and related services. Reply <strong>STOP</strong> to opt-out. Reply <strong>HELP</strong> for support. Message &amp; data rates may apply. Messaging frequency may vary. <a href="/privacy/" target="_blank">Privacy Policy</a> and <a href="/terms/" target="_blank">Terms of Service</a>.</span></label></div>
          <button type="submit" class="fkag-btn fkag-btn--apply" data-i18n="apply_submit">Submit Application</button>
          <p class="fkag-apply__note" data-i18n="apply_disclaimer">Your information is encrypted and only shared with our trusted lending partners. Read our <a href="/privacy/">Privacy Policy</a>.</p>
        </div>
        <div class="fkag-apply__success" id="fkagApplySuccess" style="display:none">
          <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
          <h3 data-i18n="apply_success_title">Application Received!</h3>
          <p data-i18n="apply_success_msg">Thank you. Our team will review your application and contact you within 1 business day.</p>
        </div>
        <div class="fkag-apply__error" id="fkagApplyError" style="display:none">
          <p data-i18n="apply_error_msg">Something went wrong. Please try again or call us at (949) 514-7366.</p>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { site } from '../../../config/site';

  (function () {
    var LANG = (function () { try { var x = localStorage.getItem('fkag_lang'); return (x === 'en' || x === 'es') ? x : 'es'; } catch (e) { return 'es'; } })();
    var TR = {
      apply_eyebrow: { en: 'CREDIT APPLICATION', es: 'APLICACIÓN DE CRÉDITO' },
      apply_title: { en: 'Apply for Financing', es: 'Aplica para Financiamiento' },
      apply_sub: { en: 'Complete the form below to start your pre-qualification. All information is securely encrypted and reviewed by our team within 1 business day.', es: 'Completa el formulario para iniciar tu pre-calificación. Toda la información está cifrada y será revisada por nuestro equipo en 1 día hábil.' },
      apply_s1_title: { en: 'Personal Information', es: 'Información Personal' },
      apply_license: { en: 'License ID', es: 'ID de Licencia' },
      apply_fname: { en: 'First Name', es: 'Nombre' },
      apply_lname: { en: 'Last Name', es: 'Apellido' },
      apply_phone: { en: 'Phone Number', es: 'Teléfono' },
      apply_email: { en: 'Email', es: 'Email' },
      apply_dob: { en: 'Date of Birth', es: 'Fecha de Nacimiento' },
      apply_ssn: { en: 'Social Security or ITIN (optional but speeds up approval)', es: 'Social Security o ITIN (opcional pero acelera la aprobación)' },
      apply_s2_title: { en: 'Address', es: 'Dirección' },
      apply_address: { en: 'Address', es: 'Dirección' },
      apply_state: { en: 'State', es: 'Estado' },
      apply_city: { en: 'City', es: 'Ciudad' },
      apply_zip: { en: 'Zip Code', es: 'Código Postal' },
      apply_residence_time: { en: 'How long have you lived at this address?', es: '¿Cuánto tiempo has vivido en esta dirección?' },
      ph_residence: { en: 'e.g. 2 years', es: 'ej. 2 años' },
      apply_s3_title: { en: 'Employment', es: 'Empleo' },
      apply_employer: { en: 'Present Employer', es: 'Empleador Actual' },
      apply_employed_time: { en: 'How long have you worked here?', es: '¿Cuánto tiempo has trabajado aquí?' },
      apply_employer_phone: { en: 'Employer Phone Number', es: 'Teléfono del Empleador' },
      apply_occupation: { en: 'Occupation', es: 'Ocupación' },
      apply_work_address: { en: 'Work Address', es: 'Dirección del Trabajo' },
      apply_self_employed: { en: 'If self-employed, what do you do?', es: 'Si trabajas por cuenta propia, ¿a qué te dedicas?' },
      apply_pay_freq: { en: 'You get paid per', es: 'Frecuencia de pago' },
      apply_freq_weekly: { en: 'Weekly', es: 'Semanal' },
      apply_freq_biweekly: { en: 'Bi-weekly', es: 'Quincenal' },
      apply_freq_monthly: { en: 'Monthly', es: 'Mensual' },
      apply_gross: { en: 'Gross Income (Monthly)', es: 'Ingreso Bruto (Mensual)' },
      apply_down: { en: 'Down Payment', es: 'Pago Inicial' },
      apply_s4_title: { en: 'Authorization', es: 'Autorización' },
      apply_authorize: { en: 'I authorize Family Key Auto Group to run and check my credit with the intention of getting an approval for a vehicle loan.', es: 'Autorizo a Family Key Auto Group a consultar mi crédito con el fin de obtener una aprobación para un préstamo vehicular.' },
      apply_yes: { en: 'Yes', es: 'Sí' },
      apply_no: { en: 'No', es: 'No' },
      apply_signature: { en: 'Signature (initials)', es: 'Firma (iniciales)' },
      apply_signature_sub: { en: 'By placing your initials you consent Family Key Auto Group to run your credit.', es: 'Al colocar tus iniciales autorizas a Family Key Auto Group a consultar tu crédito.' },
      ph_signature: { en: 'e.g. J.D.', es: 'ej. J.P.' },
      apply_s5_title: { en: 'Vehicle Trade Information (Optional)', es: 'Información del Vehículo de Intercambio (Opcional)' },
      apply_make: { en: 'Make', es: 'Marca' },
      apply_model: { en: 'Model', es: 'Modelo' },
      apply_year: { en: 'Year', es: 'Año' },
      apply_miles: { en: 'Miles', es: 'Millas' },
      apply_vin: { en: 'VIN', es: 'VIN' },
      apply_balance: { en: 'Balance Due', es: 'Saldo Pendiente' },
      apply_notes: { en: 'Notes (optional)', es: 'Notas (opcional)' },
      sms_consent_text: { en: 'By checking this box, I consent to receive SMS and calls from <strong>Family Key Auto Group</strong> regarding my inquiry about vehicles, financing, and related services. Reply <strong>STOP</strong> to opt-out. Reply <strong>HELP</strong> for support. Message &amp; data rates may apply. Messaging frequency may vary. <a href="/privacy/" target="_blank">Privacy Policy</a> and <a href="/terms/" target="_blank">Terms of Service</a>.', es: 'Al marcar esta casilla, doy mi consentimiento para recibir SMS y llamadas de <strong>Family Key Auto Group</strong> sobre mi consulta de vehículos, financiamiento y servicios relacionados. Responde <strong>STOP</strong> para cancelar. Responde <strong>HELP</strong> para soporte. Pueden aplicar tarifas. La frecuencia puede variar. <a href="/privacy/" target="_blank">Política de Privacidad</a> y <a href="/terms/" target="_blank">Términos de Servicio</a>.' },
      apply_submit: { en: 'Submit Application', es: 'Enviar Aplicación' },
      apply_disclaimer: { en: 'Your information is encrypted and only shared with our trusted lending partners. Read our <a href="/privacy/">Privacy Policy</a>.', es: 'Tu información está cifrada y solo se comparte con nuestros prestamistas de confianza. Lee nuestra <a href="/privacy/">Política de Privacidad</a>.' },
      apply_success_title: { en: 'Application Received!', es: '¡Aplicación Recibida!' },
      apply_success_msg: { en: 'Thank you. Our team will review your application and contact you within 1 business day.', es: 'Gracias. Nuestro equipo revisará tu aplicación y te contactará en 1 día hábil.' },
      apply_error_msg: { en: 'Something went wrong. Please try again or call us at (949) 514-7366.', es: 'Algo salió mal. Intenta de nuevo o llámanos al (949) 514-7366.' },
      btn_sending: { en: 'Submitting...', es: 'Enviando...' }
    };
    function t(k) { return TR[k] ? (TR[k][LANG] || TR[k].en) : k; }
    function applyTr() {
      document.querySelectorAll('.fkag-apply [data-i18n]').forEach(function (el) {
        var k = el.getAttribute('data-i18n');
        if (TR[k]) el.innerHTML = t(k);
      });
      document.querySelectorAll('.fkag-apply [data-i18n-placeholder]').forEach(function (el) {
        var k = el.getAttribute('data-i18n-placeholder');
        if (TR[k]) el.setAttribute('placeholder', t(k));
      });
    }
    applyTr();
    window.addEventListener('fkag-lang-change', function (e) {
      var nl = (e.detail && e.detail.lang) || LANG;
      if (nl === LANG) return;
      LANG = nl;
      applyTr();
    });

    var form = document.getElementById('fkagApplyForm');
    if (!form) return;

    // Prefill desde el mini-form de /financing/
    try {
      var pre = JSON.parse(sessionStorage.getItem('fkag_prefill') || '{}');
      if (pre.first_name) form.querySelector('#first_name').value = pre.first_name;
      if (pre.last_name) form.querySelector('#last_name').value = pre.last_name;
      if (pre.email) form.querySelector('#email').value = pre.email;
      if (pre.phone) form.querySelector('#phone').value = pre.phone;
      sessionStorage.removeItem('fkag_prefill');
    } catch (e) {}

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; btn.textContent = t('btn_sending'); }
      var d = {};
      new FormData(form).forEach(function (v, k) { d[k] = v; });
      var fullName = ((d.first_name || '') + ' ' + (d.last_name || '')).trim();
      var lines = [
        '=== CREDIT APPLICATION ===', '',
        '--- PERSONAL ---',
        'License ID: ' + (d.license_id || '-'),
        'Name: ' + fullName,
        'Phone: ' + (d.phone || '-'),
        'Email: ' + (d.email || '-'),
        'DOB: ' + (d.dob || '-'),
        'SSN/ITIN: ' + (d.ssn_itin || '-'), '',
        '--- ADDRESS ---',
        'Address: ' + (d.address || '-'),
        'City/State/Zip: ' + (d.city || '-') + ', ' + (d.state || '-') + ' ' + (d.zip || '-'),
        'Time at residence: ' + (d.residence_time || '-'), '',
        '--- EMPLOYMENT ---',
        'Employer: ' + (d.employer || '-'),
        'Time at job: ' + (d.employed_time || '-'),
        'Employer phone: ' + (d.employer_phone || '-'),
        'Occupation: ' + (d.occupation || '-'),
        'Work address: ' + (d.work_address || '-'),
        'Self-employed: ' + (d.self_employed_desc || '-'),
        'Pay frequency: ' + (d.pay_frequency || '-'),
        'Gross income (monthly): $' + (d.gross_income || '-'),
        'Down payment: $' + (d.down_payment || '-'), '',
        '--- AUTHORIZATION ---',
        'Authorize credit check: ' + (d.authorize || '-'),
        'Signature: ' + (d.signature || '-'), '',
        '--- TRADE-IN ---',
        'Vehicle: ' + (d.trade_year || '-') + ' ' + (d.trade_make || '') + ' ' + (d.trade_model || ''),
        'Miles: ' + (d.trade_miles || '-'),
        'VIN: ' + (d.trade_vin || '-'),
        'Balance due: $' + (d.trade_balance || '-'), '',
        '--- NOTES ---', (d.notes || '-')
      ];
      var payload = {
        form_type: 'financing',
        name: fullName,
        email: d.email || '',
        phone: d.phone || '',
        message: lines.join('\n'),
        vehicle_id: '', vehicle_title: '', preferred_date: '',
        raw_fields: d,
        _source_url: window.location.href,
        _submitted_at: new Date().toISOString(),
        _lang: LANG
      };
      var success = document.getElementById('fkagApplySuccess');
      var error = document.getElementById('fkagApplyError');
      success.style.display = 'none'; error.style.display = 'none';
      fetch(site.webhookUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json().catch(function () { return {}; }); })
        .then(function () {
          form.querySelectorAll('.fkag-apply__section, .fkag-apply__submit-wrap').forEach(function (el) { el.style.display = 'none'; });
          success.style.display = 'block';
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })
        .catch(function (err) {
          console.error('Webhook error:', err);
          error.style.display = 'block';
          error.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (btn) { btn.disabled = false; btn.style.opacity = '1'; btn.textContent = t('apply_submit'); }
        });
    });
  })();
</script>

<style>
  .fkag-apply { background: #fafaf7; padding: 80px 0 100px; width: 100%; }
  .fkag-apply__inner { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
  .fkag-apply__head { text-align: center; margin-bottom: 48px; }
  .fkag-apply__eyebrow { display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #c9a961; margin-bottom: 12px; background: rgba(201, 169, 97, 0.1); padding: 6px 14px; border-radius: 99px; border: 1px solid rgba(201, 169, 97, 0.3); }
  .fkag-apply__head h1 { font-size: 42px; font-weight: 800; color: #0c0c0c; margin: 0 0 12px; letter-spacing: -0.5px; }
  .fkag-apply__head p { font-size: 16px; color: #4a4a4a; max-width: 640px; margin: 0 auto; line-height: 1.6; }
  .fkag-apply__form { background: #fff; border-radius: 18px; padding: 48px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08); border: 1px solid #e8e4dc; }
  .fkag-apply__section { margin-bottom: 36px; padding-bottom: 28px; border-bottom: 1px solid #e8e4dc; }
  .fkag-apply__section:last-of-type { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .fkag-apply__section h3 { font-size: 18px; font-weight: 800; color: #0c0c0c; margin: 0 0 20px; letter-spacing: 0.3px; padding-left: 14px; border-left: 4px solid #c9a961; }
  .fkag-apply__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .fkag-field { display: flex; flex-direction: column; }
  .fkag-field--full { grid-column: 1 / -1; }
  .fkag-field label { font-size: 13px; font-weight: 600; color: #0c0c0c; margin-bottom: 6px; }
  .fkag-field__hint { font-size: 12px; color: #6b6b6b; margin: 0 0 8px; line-height: 1.4; }
  .fkag-field input, .fkag-field select, .fkag-field textarea { padding: 12px 14px; border: 1.5px solid #e8e4dc; border-radius: 8px; font-size: 15px; font-family: inherit; color: #0c0c0c; background: #fff; transition: border-color 0.2s, box-shadow 0.2s; }
  .fkag-field input:focus, .fkag-field select:focus, .fkag-field textarea:focus { outline: none; border-color: #c9a961; box-shadow: 0 0 0 3px rgba(201, 169, 97, 0.15); }
  .fkag-field textarea { resize: vertical; min-height: 90px; }
  .fkag-apply__submit-wrap { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; margin-top: 24px; width: 100%; }
  .fkag-sms-consent__label { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; max-width: 640px; text-align: left; }
  .fkag-sms-consent__label input[type='checkbox'] { flex-shrink: 0; width: 16px; height: 16px; margin-top: 2px; accent-color: #c9a961; cursor: pointer; }
  .fkag-sms-consent__text { font-size: 11.5px; line-height: 1.5; color: #6b6b6b; }
  .fkag-sms-consent__text strong { color: #0c0c0c; font-weight: 700; }
  .fkag-sms-consent__text a { color: #c9a961; text-decoration: underline; }
  .fkag-btn--apply { background: #c9a961; color: #0c0c0c; border: 0; padding: 18px 56px; border-radius: 10px; font-weight: 800; font-size: 16px; letter-spacing: 0.5px; cursor: pointer; transition: all 0.2s; text-transform: uppercase; }
  .fkag-btn--apply:hover { background: #d4b674; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(201, 169, 97, 0.35); }
  .fkag-btn--apply:disabled { background: #c4c4c4; cursor: not-allowed; transform: none; box-shadow: none; }
