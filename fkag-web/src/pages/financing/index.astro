---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lenders } from '../../config/site';
---

<BaseLayout title="Financiamiento" description="Pre-califica en minutos con Family Key Auto Group. Consulta suave sin impacto en tu crédito, 12+ prestamistas confiables.">
  <!-- ===== SECCIÓN 1: HERO + MINI FORM ===== -->
  <section class="fkag fkag-fin-hero">
    <div class="fkag-fin-hero__inner">
      <div class="fkag-fin-hero__left">
        <span class="fkag-fin-hero__eyebrow" data-i18n="fin_eyebrow_hero">FAST · SECURE · NO IMPACT</span>
        <h1 data-i18n="fin_hero_title">Get Pre-Qualified in Minutes</h1>
        <p data-i18n="fin_hero_sub">Whatever your credit looks like, we work with multiple lenders to find the financing that fits your life. No hard credit pulls, no obligations — just answers.</p>
        <ul class="fkag-fin-hero__list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.5" width="22" height="22"><path d="M20 6L9 17l-5-5"/></svg><span data-i18n="fin_hero_li1">Soft credit check — no impact on your score</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.5" width="22" height="22"><path d="M20 6L9 17l-5-5"/></svg><span data-i18n="fin_hero_li2">All credit profiles welcome, including first-time buyers</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.5" width="22" height="22"><path d="M20 6L9 17l-5-5"/></svg><span data-i18n="fin_hero_li3">Real rates from 12+ trusted lenders</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.5" width="22" height="22"><path d="M20 6L9 17l-5-5"/></svg><span data-i18n="fin_hero_li4">Decision in as little as 60 seconds</span></li>
        </ul>
      </div>
      <div class="fkag-fin-hero__right">
        <div class="fkag-fin-hero__card">
          <div class="fkag-fin-hero__card-head">
            <span class="fkag-fin-hero__card-badge"><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span data-i18n="fin_form_secure">100% Secure</span></span>
            <h3 data-i18n="fin_form_title">Quick Pre-Qualification</h3>
            <p class="fkag-fin-hero__card-sub" data-i18n="fin_form_sub">Takes about 2 minutes. No SSN required.</p>
          </div>
          <form class="fkag-fin-hero__form" id="fkagFinHeroForm">
            <div class="fkag-fin-hero__row">
              <div class="fkag-fin-hero__field"><label data-i18n="form_fname">First Name</label><div class="fkag-fin-hero__input-wrap"><svg class="fkag-fin-hero__input-icon" viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="16" height="16" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" name="first_name" data-i18n-placeholder="ph_fname" placeholder="John" required></div></div>
              <div class="fkag-fin-hero__field"><label data-i18n="form_lname">Last Name</label><div class="fkag-fin-hero__input-wrap"><svg class="fkag-fin-hero__input-icon" viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="16" height="16" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" name="last_name" data-i18n-placeholder="ph_lname" placeholder="Doe" required></div></div>
            </div>
            <div class="fkag-fin-hero__field"><label data-i18n="form_email">Email</label><div class="fkag-fin-hero__input-wrap"><svg class="fkag-fin-hero__input-icon" viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="16" height="16" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg><input type="email" name="email" data-i18n-placeholder="ph_email" placeholder="email@example.com" required></div></div>
            <div class="fkag-fin-hero__field"><label data-i18n="form_phone">Phone</label><div class="fkag-fin-hero__input-wrap"><svg class="fkag-fin-hero__input-icon" viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="16" height="16" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><input type="tel" name="phone" placeholder="(949) 514-7366" required></div></div>
            <div class="fkag-sms-consent"><label class="fkag-sms-consent__label"><input type="checkbox" name="sms_consent" required><span class="fkag-sms-consent__text" data-i18n="sms_consent_text">By checking this box, I consent to receive SMS and calls from <strong>Family Key Auto Group</strong> regarding my inquiry about vehicles, financing, and related services. Reply <strong>STOP</strong> to opt-out. Reply <strong>HELP</strong> for support. Message &amp; data rates may apply. Messaging frequency may vary. <a href="/privacy/" target="_blank">Privacy Policy</a> and <a href="/terms/" target="_blank">Terms of Service</a>.</span></label></div>
            <button type="submit" class="fkag-btn--apply-orange"><span data-i18n="fin_form_submit">Get Pre-Qualified Now</span><svg viewBox="0 0 24 24" fill="none" stroke="#0c0c0c" stroke-width="2.5" width="18" height="18" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
            <div class="fkag-fin-hero__trust"><div class="fkag-fin-hero__trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span data-i18n="fin_form_trust1">SSL Encrypted</span></div><div class="fkag-fin-hero__trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.5" width="14" height="14" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span data-i18n="fin_form_trust2">No Credit Impact</span></div></div>
            <p class="fkag-fin-hero__disclaimer" data-i18n="fin_form_disclaimer">By submitting you agree to our terms. This is a soft inquiry — no impact on your credit score.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SECCIÓN 2: 4 PASOS ===== -->
  <section class="fkag fkag-fin-steps">
    <div class="fkag-fin-steps__inner">
      <div class="fkag-fin-steps__head"><span class="fkag-fin-steps__eyebrow" data-i18n="fin_eyebrow">HOW IT WORKS</span><h2 data-i18n="fin_title">Financing made simple, in 4 steps.</h2><p data-i18n="fin_sub">A straightforward process designed to get you behind the wheel faster.</p></div>
      <div class="fkag-fin-steps__grid">
        <div class="fkag-step"><div class="fkag-step__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="32" height="32" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div><span class="fkag-step__number">1</span><h3 data-i18n="step_apply_title">Apply Online</h3><p data-i18n="step_apply_desc">Fill out our 2-minute pre-qualification form. No SSN, no hard credit pull.</p></div>
        <div class="fkag-step"><div class="fkag-step__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="32" height="32" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 9h.01M13 9h.01M9 13h.01M13 13h.01M9 17h.01M13 17h.01"/></svg></div><span class="fkag-step__number">2</span><h3 data-i18n="step_shop_title">We Shop Lenders</h3><p data-i18n="step_shop_desc">Our team submits your profile to 12+ trusted lenders to find your best rate.</p></div>
        <div class="fkag-step"><div class="fkag-step__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.5" width="32" height="32" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div><span class="fkag-step__number">3</span><h3 data-i18n="step_choose_title">Choose Your Offer</h3><p data-i18n="step_choose_desc">Review terms, monthly payments, and pick the option that fits your budget.</p></div>
        <div class="fkag-step"><div class="fkag-step__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2" width="32" height="32" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg></div><span class="fkag-step__number">4</span><h3 data-i18n="step_drive_title">Drive Home</h3><p data-i18n="step_drive_desc">Sign with us, get the keys, and enjoy your new ride. It's that easy.</p></div>
      </div>
    </div>
  </section>

  <!-- ===== SECCIÓN 3: LENDERS ===== -->
  <section class="fkag fkag-lenders-sect">
    <div class="fkag-lenders-sect__inner">
      <div class="fkag-lenders-sect__head"><span class="fkag-lenders-sect__eyebrow" data-i18n="partners_eyebrow">TRUSTED PARTNERS</span><h2 data-i18n="partners_title">We work with 12+ top lenders.</h2><p data-i18n="partners_sub">Banks, credit unions, and specialty lenders — all competing to give you the best rate.</p></div>
      <div class="fkag-lenders-sect__grid">
        {
          lenders.map((l) => (
            <div class="fkag-lender-item">
              <img src={l.img} alt={l.name} loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
              <span class="fkag-lender-item__text">{l.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== SECCIÓN 4: FAQs ===== -->
  <section class="fkag fkag-fin-faq">
    <div class="fkag-fin-faq__inner">
      <div class="fkag-fin-faq__head"><span class="fkag-fin-faq__eyebrow" data-i18n="faq_eyebrow">COMMON QUESTIONS</span><h2 data-i18n="faq_fin_title">Financing FAQs</h2></div>
      <div class="fkag-fin-faq__list">
        <details class="fkag-fin-faq__item"><summary><span data-i18n="faq_q1">Will applying hurt my credit score?</span><span class="fkag-fin-faq__plus">+</span></summary><div class="fkag-fin-faq__a"><p data-i18n="faq_q1_a">No. Our pre-qualification process uses a soft credit inquiry, which has no impact on your credit score. A hard inquiry only happens if you choose to move forward with a final loan offer.</p></div></details>
        <details class="fkag-fin-faq__item"><summary><span data-i18n="faq_fin_q2">What if I have bad or no credit?</span><span class="fkag-fin-faq__plus">+</span></summary><div class="fkag-fin-faq__a"><p data-i18n="faq_fin_q2_a">We work with lenders that specialize in all credit profiles, including first-time buyers, no credit, and rebuilding credit. Most of our customers get approved.</p></div></details>
        <details class="fkag-fin-faq__item"><summary><span data-i18n="faq_fin_q3">How much down payment do I need?</span><span class="fkag-fin-faq__plus">+</span></summary><div class="fkag-fin-faq__a"><p data-i18n="faq_fin_q3_a">It depends on your credit profile and the vehicle. We offer options starting from a low down payment, and trade-ins can be applied as down payment too.</p></div></details>
        <details class="fkag-fin-faq__item"><summary><span data-i18n="faq_fin_q4">Do you accept ITIN?</span><span class="fkag-fin-faq__plus">+</span></summary><div class="fkag-fin-faq__a"><p data-i18n="faq_fin_q4_a">Yes. We work with lenders that accept ITIN and we'll guide you through the entire process — no SSN required.</p></div></details>
        <details class="fkag-fin-faq__item"><summary><span data-i18n="faq_fin_q5">How fast can I drive home?</span><span class="fkag-fin-faq__plus">+</span></summary><div class="fkag-fin-faq__a"><p data-i18n="faq_fin_q5_a">Most customers complete the entire process and drive home the same day. Pre-qualification takes 60 seconds, and final approval can happen within hours.</p></div></details>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { site } from '../../config/site';

  (function () {
    var LANG = (function () { try { var x = localStorage.getItem('fkag_lang'); return (x === 'en' || x === 'es') ? x : 'es'; } catch (e) { return 'es'; } })();
    var TR = {
      fin_eyebrow_hero: { en: 'FAST · SECURE · NO IMPACT', es: 'RÁPIDO · SEGURO · SIN IMPACTO' },
      fin_hero_title: { en: 'Get Pre-Qualified in Minutes', es: 'Pre-Califica en Minutos' },
      fin_hero_sub: { en: 'Whatever your credit looks like, we work with multiple lenders to find the financing that fits your life. No hard credit pulls, no obligations — just answers.', es: 'Sin importar tu crédito, trabajamos con varios prestamistas para encontrarte el financiamiento que se ajuste a tu vida. Sin consultas duras, sin obligaciones — solo respuestas.' },
      fin_hero_li1: { en: 'Soft credit check — no impact on your score', es: 'Consulta suave de crédito — sin impacto en tu puntaje' },
      fin_hero_li2: { en: 'All credit profiles welcome, including first-time buyers', es: 'Todos los perfiles de crédito bienvenidos, incluyendo compradores primerizos' },
      fin_hero_li3: { en: 'Real rates from 12+ trusted lenders', es: 'Tasas reales de 12+ prestamistas confiables' },
      fin_hero_li4: { en: 'Decision in as little as 60 seconds', es: 'Decisión en tan solo 60 segundos' },
      fin_form_secure: { en: '100% Secure', es: '100% Seguro' },
      fin_form_title: { en: 'Quick Pre-Qualification', es: 'Pre-Calificación Rápida' },
      fin_form_sub: { en: 'Takes about 2 minutes. No SSN required.', es: 'Toma unos 2 minutos. No se requiere SSN.' },
      form_fname: { en: 'First Name', es: 'Nombre' },
      form_lname: { en: 'Last Name', es: 'Apellido' },
      form_email: { en: 'Email', es: 'Email' },
      form_phone: { en: 'Phone', es: 'Teléfono' },
      ph_fname: { en: 'John', es: 'Juan' },
      ph_lname: { en: 'Doe', es: 'Pérez' },
      ph_email: { en: 'email@example.com', es: 'email@ejemplo.com' },
      sms_consent_text: {
        en: 'By checking this box, I consent to receive SMS and calls from <strong>Family Key Auto Group</strong> regarding my inquiry about vehicles, financing, and related services. Reply <strong>STOP</strong> to opt-out. Reply <strong>HELP</strong> for support. Message &amp; data rates may apply. Messaging frequency may vary. <a href="/privacy/" target="_blank">Privacy Policy</a> and <a href="/terms/" target="_blank">Terms of Service</a>.',
        es: 'Al marcar esta casilla, doy mi consentimiento para recibir SMS y llamadas de <strong>Family Key Auto Group</strong> sobre mi consulta de vehículos, financiamiento y servicios relacionados. Responde <strong>STOP</strong> para cancelar. Responde <strong>HELP</strong> para soporte. Pueden aplicar tarifas de mensajes y datos. La frecuencia de mensajes puede variar. <a href="/privacy/" target="_blank">Política de Privacidad</a> y <a href="/terms/" target="_blank">Términos de Servicio</a>.'
      },
      fin_form_submit: { en: 'Get Pre-Qualified Now', es: 'Pre-Calificar Ahora' },
      fin_form_trust1: { en: 'SSL Encrypted', es: 'Cifrado SSL' },
      fin_form_trust2: { en: 'No Credit Impact', es: 'Sin Impacto al Crédito' },
      fin_form_disclaimer: { en: 'By submitting you agree to our terms. This is a soft inquiry — no impact on your credit score.', es: 'Al enviar aceptas nuestros términos. Esta es una consulta suave — sin impacto en tu puntaje de crédito.' },
      fin_eyebrow: { en: 'HOW IT WORKS', es: 'CÓMO FUNCIONA' },
      fin_title: { en: 'Financing made simple, in 4 steps.', es: 'Financiamiento sencillo, en 4 pasos.' },
      fin_sub: { en: 'A straightforward process designed to get you behind the wheel faster.', es: 'Un proceso directo diseñado para ponerte al volante más rápido.' },
      step_apply_title: { en: 'Apply Online', es: 'Aplica en Línea' },
      step_apply_desc: { en: 'Fill out our 2-minute pre-qualification form. No SSN, no hard credit pull.', es: 'Llena nuestro formulario de pre-calificación de 2 minutos. Sin SSN, sin consulta dura.' },
      step_shop_title: { en: 'We Shop Lenders', es: 'Buscamos Prestamistas' },
      step_shop_desc: { en: 'Our team submits your profile to 12+ trusted lenders to find your best rate.', es: 'Nuestro equipo envía tu perfil a 12+ prestamistas confiables para encontrar tu mejor tasa.' },
      step_choose_title: { en: 'Choose Your Offer', es: 'Elige Tu Oferta' },
      step_choose_desc: { en: 'Review terms, monthly payments, and pick the option that fits your budget.', es: 'Revisa términos, pagos mensuales, y elige la opción que se ajuste a tu presupuesto.' },
      step_drive_title: { en: 'Drive Home', es: 'Llévatelo a Casa' },
      step_drive_desc: { en: "Sign with us, get the keys, and enjoy your new ride. It's that easy.", es: 'Firma con nosotros, recibe las llaves, y disfruta tu nuevo auto. Así de fácil.' },
      partners_eyebrow: { en: 'TRUSTED PARTNERS', es: 'ALIADOS DE CONFIANZA' },
      partners_title: { en: 'We work with 12+ top lenders.', es: 'Trabajamos con 12+ prestamistas líderes.' },
      partners_sub: { en: 'Banks, credit unions, and specialty lenders — all competing to give you the best rate.', es: 'Bancos, cooperativas de crédito y prestamistas especializados — todos compitiendo para darte la mejor tasa.' },
      faq_eyebrow: { en: 'COMMON QUESTIONS', es: 'PREGUNTAS COMUNES' },
      faq_fin_title: { en: 'Financing FAQs', es: 'Preguntas Frecuentes de Financiamiento' },
      faq_q1: { en: 'Will applying hurt my credit score?', es: '¿Aplicar afectará mi puntaje de crédito?' },
      faq_q1_a: { en: 'No. Our pre-qualification process uses a soft credit inquiry, which has no impact on your credit score. A hard inquiry only happens if you choose to move forward with a final loan offer.', es: 'No. Nuestro proceso de pre-calificación usa una consulta suave de crédito, que no impacta tu puntaje. Una consulta dura solo ocurre si decides avanzar con una oferta final de préstamo.' },
      faq_fin_q2: { en: 'What if I have bad or no credit?', es: '¿Qué pasa si tengo mal crédito o no tengo crédito?' },
      faq_fin_q2_a: { en: 'We work with lenders that specialize in all credit profiles, including first-time buyers, no credit, and rebuilding credit. Most of our customers get approved.', es: 'Trabajamos con prestamistas que se especializan en todos los perfiles de crédito, incluyendo compradores primerizos, sin crédito y reconstrucción de crédito. La mayoría de nuestros clientes son aprobados.' },
      faq_fin_q3: { en: 'How much down payment do I need?', es: '¿Cuánto pago inicial necesito?' },
      faq_fin_q3_a: { en: 'It depends on your credit profile and the vehicle. We offer options starting from a low down payment, and trade-ins can be applied as down payment too.', es: 'Depende de tu perfil de crédito y el vehículo. Ofrecemos opciones desde un pago inicial bajo, y los intercambios pueden aplicarse como pago inicial también.' },
      faq_fin_q4: { en: 'Do you accept ITIN?', es: '¿Aceptan ITIN?' },
      faq_fin_q4_a: { en: "Yes. We work with lenders that accept ITIN and we'll guide you through the entire process — no SSN required.", es: 'Sí. Trabajamos con prestamistas que aceptan ITIN y te guiaremos durante todo el proceso — no se requiere SSN.' },
      faq_fin_q5: { en: 'How fast can I drive home?', es: '¿Qué tan rápido puedo llevarme el auto?' },
      faq_fin_q5_a: { en: 'Most customers complete the entire process and drive home the same day. Pre-qualification takes 60 seconds, and final approval can happen within hours.', es: 'La mayoría de los clientes completan todo el proceso y se llevan el auto el mismo día. La pre-calificación toma 60 segundos, y la aprobación final puede ocurrir en horas.' }
    };
    function t(k) { return TR[k] ? (TR[k][LANG] || TR[k].en) : k; }
    function applyTranslations() {
      document.querySelectorAll('.fkag-fin-hero [data-i18n],.fkag-fin-steps [data-i18n],.fkag-lenders-sect [data-i18n],.fkag-fin-faq [data-i18n]').forEach(function (el) {
        var k = el.getAttribute('data-i18n');
        if (TR[k]) el.innerHTML = t(k);
      });
      document.querySelectorAll('.fkag-fin-hero [data-i18n-placeholder]').forEach(function (el) {
        var k = el.getAttribute('data-i18n-placeholder');
        if (TR[k]) el.setAttribute('placeholder', t(k));
      });
    }
    applyTranslations();
    window.addEventListener('fkag-lang-change', function (e) {
      var nl = (e.detail && e.detail.lang) || LANG;
      if (nl === LANG) return;
      LANG = nl;
      applyTranslations();
    });

    // ===== MINI FORM SUBMIT =====
    var form = document.getElementById('fkagFinHeroForm');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; }
      var d = {};
      new FormData(form).forEach(function (v, k) { d[k] = v; });
      var fullName = ((d.first_name || '') + ' ' + (d.last_name || '')).trim();
      var payload = {
        form_type: 'financing_quick',
        name: fullName,
        email: d.email || '',
        phone: d.phone || '',
        message: 'Pre-calificación rápida desde /financing/ (mini form). Esperando que complete la app completa.',
        _source_url: window.location.href,
        _submitted_at: new Date().toISOString(),
        _lang: LANG
      };
      try {
        sessionStorage.setItem('fkag_prefill', JSON.stringify({
          first_name: d.first_name || '', last_name: d.last_name || '', email: d.email || '', phone: d.phone || ''
        }));
      } catch (e) {}
      fetch(site.webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true
