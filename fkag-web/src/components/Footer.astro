---
import { site, assets } from '../config/site';
import { t } from '../i18n';

const year = new Date().getFullYear();
const L = 'es'; // idioma por defecto para el render inicial (SSR); el cliente lo cambia
---

<footer class="fkag-footer">
  <div class="fkag-footer__top">
    <div class="fkag-footer__inner">
      <div class="fkag-footer__col fkag-footer__col--brand">
        <img
          src={assets.logoFooter}
          alt={site.name}
          class="fkag-footer__logo"
          width="200"
          height="55"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
        />
        <span class="fkag-footer__logo-fallback">FAMILY KEY<b>AUTO GROUP</b></span>
        <p class="fkag-footer__tagline">
          <span data-i18n="footer_tagline">{t('footer_tagline', L)}</span>
        </p>
      </div>

      <div class="fkag-footer__col">
        <h4 data-i18n="footer_inventory_title">{t('footer_inventory_title', L)}</h4>
        <ul>
          <li><a href="/inventory/"><span data-i18n="footer_view_all">{t('footer_view_all', L)}</span></a></li>
          <li><a href="/inventory/?filter=under-20k"><span data-i18n="footer_under_20k">{t('footer_under_20k', L)}</span></a></li>
          <li><a href="/inventory/?filter=under-10k"><span data-i18n="footer_under_10k">{t('footer_under_10k', L)}</span></a></li>
        </ul>
      </div>

      <div class="fkag-footer__col">
        <h4 data-i18n="footer_resources_title">{t('footer_resources_title', L)}</h4>
        <ul>
          <li><a href="/financing/apply/"><span data-i18n="footer_apply">{t('footer_apply', L)}</span></a></li>
          <li><a href="/about/"><span data-i18n="footer_about">{t('footer_about', L)}</span></a></li>
          <li><a href="/contact/"><span data-i18n="footer_contact">{t('footer_contact', L)}</span></a></li>
          <li><a href="/faqs/"><span data-i18n="footer_faqs">{t('footer_faqs', L)}</span></a></li>
        </ul>
      </div>

      <div class="fkag-footer__col">
        <h4 data-i18n="footer_newsletter_title">{t('footer_newsletter_title', L)}</h4>
        <p data-i18n="footer_newsletter_sub">{t('footer_newsletter_sub', L)}</p>
        <form class="fkag-footer__newsletter" id="fkagNewsletterForm">
          <div class="fkag-footer__email-wrap">
            <svg
              class="fkag-footer__email-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              width="18"
              height="18"
              aria-hidden="true"
            >
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <input
              type="email"
              placeholder="tu@email.com"
              data-i18n-placeholder="footer_email_placeholder"
              required
            />
          </div>
          <button type="submit"><span data-i18n="footer_subscribe">{t('footer_subscribe', L)}</span></button>
        </form>
      </div>
    </div>
  </div>

  <div class="fkag-footer__bottom">
    <div class="fkag-footer__bottom-inner">
      <p>© {year} <span data-i18n="footer_copyright_post">{t('footer_copyright_post', L)}</span></p>
      <div class="fkag-footer__legal">
        <a href="/privacy/"><span data-i18n="footer_privacy">{t('footer_privacy', L)}</span></a>
        <a href="/terms/"><span data-i18n="footer_terms">{t('footer_terms', L)}</span></a>
        <a href="/sitemap/"><span data-i18n="footer_sitemap">{t('footer_sitemap', L)}</span></a>
        <a href="/accessibility/"><span data-i18n="footer_accessibility">{t('footer_accessibility', L)}</span></a>
      </div>
    </div>
  </div>
</footer>

<script define:vars={{ webhookUrl: site.webhookUrl }}>
  (function () {
    var f = document.getElementById('fkagNewsletterForm');
    if (!f) return;
    var LABELS = {
      es: { sending: 'Enviando...', ok: '¡Suscrito!', retry: 'Reintentar' },
      en: { sending: 'Sending...', ok: 'Subscribed!', retry: 'Try Again' },
    };
    function lang() {
      try {
        var x = localStorage.getItem('fkag_lang');
        return x === 'en' || x === 'es' ? x : 'es';
      } catch (e) {
        return 'es';
      }
    }
    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      var input = f.querySelector('input[type=email]');
      var btn = f.querySelector('button');
      var span = btn.querySelector('span');
      var email = (input.value || '').trim();
      if (!email) return;
      var l = LABELS[lang()];
      btn.disabled = true;
      if (span) span.textContent = l.sending;
      else btn.textContent = l.sending;
      try {
        await fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ form_type: 'newsletter', email: email }),
        });
        if (span) span.textContent = l.ok;
        else btn.textContent = l.ok;
        input.value = '';
      } catch (err) {
        if (span) span.textContent = l.retry;
        else btn.textContent = l.retry;
        btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .fkag-footer {
    background: #0a0a0a;
    color: #cbd5e1;
    width: 100%;
  }
  .fkag-footer__top {
    padding: 70px 0 50px;
  }
  .fkag-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 50px;
  }
  .fkag-footer__logo {
    height: 50px;
    width: auto;
    margin-bottom: 16px;
  }
  .fkag-footer__logo-fallback {
    display: none;
    flex-direction: column;
    line-height: 1;
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 1px;
    color: #c9a961;
    margin-bottom: 16px;
  }
  .fkag-footer__logo-fallback b {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 4px;
    color: #94a3b8;
  }
  .fkag-footer__tagline {
    font-size: 15px;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 22px 0;
  }
  .fkag-footer__col h4 {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 18px 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .fkag-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fkag-footer__col ul li {
    margin-bottom: 10px;
  }
  .fkag-footer__col ul li a {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  .fkag-footer__col ul li a:hover {
    color: #c9a961;
  }
  .fkag-footer__col p {
    font-size: 14px;
    color: #94a3b8;
    margin: 0 0 14px 0;
    line-height: 1.5;
  }
  .fkag-footer__newsletter {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fkag-footer__email-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .fkag-footer__email-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #c9a961;
    pointer-events: none;
    z-index: 2;
  }
  .fkag-footer__newsletter input[type='email'] {
    padding: 12px 14px 12px 42px;
    border-radius: 8px;
    border: 2px solid transparent;
    background: #1a2942;
    color: #fff;
    font-size: 14px;
    width: 100%;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    appearance: none;
  }
  .fkag-footer__newsletter input[type='email']::placeholder {
    color: #7a8595;
    opacity: 1;
  }
  .fkag-footer__newsletter input[type='email']:hover {
    border-color: rgba(201, 169, 97, 0.5);
  }
  .fkag-footer__newsletter input[type='email']:focus {
    border-color: #c9a961;
    box-shadow: 0 0 0 3px rgba(201, 169, 97, 0.25);
  }
  .fkag-footer__newsletter button {
    padding: 12px 14px;
    border-radius: 8px;
    border: none;
    background: #c9a961;
    color: #1a1a1a;
    font-weight: 700;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.2s;
  }
  .fkag-footer__newsletter button:hover {
    background: #d4b674;
  }
  .fkag-footer__bottom {
    border-top: 1px solid #1a2942;
    padding: 22px 0;
  }
  .fkag-footer__bottom-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .fkag-footer__bottom-inner p {
    margin: 0;
    font-size: 13px;
    color: #7a8595;
  }
  .fkag-footer__legal {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .fkag-footer__legal a {
    color: #7a8595;
    text-decoration: none;
    font-size: 13px;
  }
  .fkag-footer__legal a:hover {
    color: #cbd5e1;
  }
  @media (max-width: 980px) {
    .fkag-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      padding: 0 24px;
    }
    .fkag-footer__bottom-inner {
      padding: 0 24px;
      flex-direction: column;
      text-align: center;
    }
  }
  @media (max-width: 640px) {
    .fkag-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
