---
import { t, getDict, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const items = getDict(lang).testimonials.items;
---
<section id="testimonials" class="bg-[var(--color-nude-50)] py-20 sm:py-28">
  <div class="container-px mx-auto max-w-7xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">{t(lang, 'testimonials.eyebrow')}</span>
      <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">
        {t(lang, 'testimonials.title')}
      </h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {items.map((it) => (
        <figure class="card reveal flex flex-col">
          <div class="flex gap-1 text-[var(--color-rose-500)]" aria-label="5 stars">
            {[1,2,3,4,5].map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ))}
          </div>
          <blockquote class="mt-5 flex-1 text-base leading-relaxed text-[var(--color-graphite)]">
            “{it.text}”
          </blockquote>
          <figcaption class="mt-6 border-t border-[var(--color-line)] pt-4">
            <div class="font-display font-semibold">{it.name}</div>
            <div class="text-xs uppercase tracking-widest text-[var(--color-rose-600)]">{it.service}</div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
