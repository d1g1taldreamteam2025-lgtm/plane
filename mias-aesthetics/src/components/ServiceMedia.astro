---
import { type Lang } from "../i18n";
import {
  reelsByService,
  IV_VISUALS_VERTICAL,
  IV_VISUALS_SQUARE,
  THERMAGE_MEDIA,
  SALMON_MEDIA,
  LASHES_MEDIA,
  MORPHEUS_MEDIA,
  FACIAL_MEDIA,
  DPL_MEDIA,
  DERMAPEN_MEDIA,
  type ServiceTag,
} from "../data/reels.ts";

interface Props {
  lang: Lang;
  service: ServiceTag;
  /** Si true, intercala las imágenes 9:16 con los videos y agrega las 1:1 abajo. */
  withVisuals?: boolean;
}
const { lang, service, withVisuals = false } = Astro.props;

const isThermage = service === "thermage";
const isSalmon = service === "salmon";
const isLashes = service === "lashes";
const isMorpheus = service === "morpheus";
const isFacial = service === "facial";
const isDpl = service === "dpl";
const isDermapen = service === "dermapen";
const useCustom = isThermage || isSalmon || isLashes || isMorpheus || isFacial || isDpl || isDermapen;
const videos = useCustom ? [] : reelsByService(service);
const verticalVisuals = withVisuals ? IV_VISUALS_VERTICAL : [];
const squareVisuals   = withVisuals ? IV_VISUALS_SQUARE : [];

if (
  !useCustom &&
  videos.length === 0 &&
  verticalVisuals.length === 0 &&
  squareVisuals.length === 0
) {
  return null;
}

const t = {
  es: {
    eyebrow: "En acción",
    title: "Mira el tratamiento",
    subtitle: "Videos reales del estudio. Toca para reproducir con sonido.",
    visuals_title: "Material informativo",
    erlym: "Erlym en cámara",
    thermage_results_title: "Resultados Thermage",
    salmon_image_title: "Esperma de salmón en detalle",
    lashes_results_title: "Antes y después · Pestañas",
    morpheus_results_title: "Antes y después · Morpheus 8",
    facial_results_title: "Tu cara bonita en detalle",
    dpl_image_title: "Tratamiento DPL en detalle",
    dermapen_image_title: "Antes y después · Dermapen",
  },
  en: {
    eyebrow: "In action",
    title: "See the treatment",
    subtitle: "Real videos from the studio. Tap to play with sound.",
    visuals_title: "Info material",
    erlym: "Erlym on camera",
    thermage_results_title: "Thermage results",
    salmon_image_title: "Salmon DNA in detail",
    lashes_results_title: "Before & after · Lashes",
    morpheus_results_title: "Before & after · Morpheus 8",
    facial_results_title: "Your fresh face in detail",
    dpl_image_title: "DPL treatment in detail",
    dermapen_image_title: "Before & after · Dermapen",
  },
}[lang];

const featured = videos[0];
const restVideos = videos.slice(1);
---
<section class="bg-gradient-to-b from-white via-[var(--color-blush-50)] to-white py-16 sm:py-20">
  <div class="container-px mx-auto max-w-6xl">
    <div class="text-center">
      <span class="eyebrow eyebrow-gold">{t.eyebrow}</span>
      <h2 class="h-display mt-4 text-[clamp(1.75rem,4vw,2.75rem)]">{t.title}</h2>
      <p class="mt-2 text-sm text-[var(--color-gray-soft)] sm:text-base">{t.subtitle}</p>
    </div>

    {isThermage && (
      <div class="mt-10 space-y-6">
        {/* Video landscape 16:9 */}
        <article class="service-video group relative aspect-video cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)]">
          <video
            class="service-video-media absolute inset-0 h-full w-full object-cover"
            src={THERMAGE_MEDIA.video}
            poster={THERMAGE_MEDIA.poster}
            preload="metadata"
            playsinline
            loop
          ></video>
          <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>
        </article>

        {/* 2 imágenes cuadradas 1:1 */}
        <div>
          <h3 class="text-center font-display text-xl font-bold sm:text-2xl">{t.thermage_results_title}</h3>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {THERMAGE_MEDIA.squares.map((src) => (
              <article class="relative aspect-square overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-md transition hover:-translate-y-1 hover:shadow-lg">
                <img
                  src={src}
                  alt={t.thermage_results_title}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </article>
            ))}
          </div>
        </div>
      </div>
    )}

    {isDermapen && (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {/* Video 9:16 */}
        <article class="service-video group relative mx-auto aspect-[9/16] w-full max-w-sm cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)]">
          <video
            class="service-video-media absolute inset-0 h-full w-full object-cover"
            src={DERMAPEN_MEDIA.video}
            poster={DERMAPEN_MEDIA.poster}
            preload="metadata"
            playsinline
            loop
          ></video>
          <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>
        </article>

        {/* Imagen antes/después */}
        <article class="relative mx-auto aspect-square w-full max-w-sm overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.25)] transition hover:-translate-y-1 hover:shadow-xl">
          <img
            src={DERMAPEN_MEDIA.image}
            alt={t.dermapen_image_title}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
        </article>
      </div>
    )}

    {isDpl && (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {/* Video 9:16 */}
        <article class="service-video group relative mx-auto aspect-[9/16] w-full max-w-sm cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)]">
          <video
            class="service-video-media absolute inset-0 h-full w-full object-cover"
            src={DPL_MEDIA.video}
            poster={DPL_MEDIA.poster}
            preload="metadata"
            playsinline
            loop
          ></video>
          <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>
        </article>

        {/* Imagen */}
        <article class="relative mx-auto aspect-square w-full max-w-sm overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.25)] transition hover:-translate-y-1 hover:shadow-xl">
          <img
            src={DPL_MEDIA.image}
            alt={t.dpl_image_title}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
        </article>
      </div>
    )}

    {isFacial && (
      <div class="mt-10 space-y-8">
        {/* Video 9:16 centrado */}
        <article class="service-video group relative mx-auto aspect-[9/16] w-full max-w-sm cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)]">
          <video
            class="service-video-media absolute inset-0 h-full w-full object-cover"
            src={FACIAL_MEDIA.video}
            poster={FACIAL_MEDIA.poster}
            preload="metadata"
            playsinline
            loop
          ></video>
          <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>
        </article>

        {/* 2 imágenes */}
        <div>
          <h3 class="text-center font-display text-xl font-bold sm:text-2xl">{t.facial_results_title}</h3>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {FACIAL_MEDIA.images.map((src) => (
              <article class="relative aspect-square overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-md transition hover:-translate-y-1 hover:shadow-lg">
                <img
                  src={src}
                  alt={t.facial_results_title}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </article>
            ))}
          </div>
        </div>
      </div>
    )}

    {isMorpheus && (
      <div class="mt-10 space-y-8">
        {/* 2 videos 9:16 lado a lado */}
        <div class="grid gap-4 sm:grid-cols-2">
          {MORPHEUS_MEDIA.videos.map((v) => (
            <article class="service-video group relative mx-auto aspect-[9/16] w-full max-w-sm cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)]">
              <video
                class="service-video-media absolute inset-0 h-full w-full object-cover"
                src={v.src}
                poster={v.poster}
                preload="metadata"
                playsinline
                loop
              ></video>
              <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
                <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </div>
            </article>
          ))}
        </div>

        {/* Imagen antes/después */}
        <div>
          <h3 class="text-center font-display text-xl font-bold sm:text-2xl">{t.morpheus_results_title}</h3>
          <article class="mt-6 relative mx-auto aspect-square w-full max-w-xl overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.25)] transition hover:-translate-y-1 hover:shadow-xl">
            <img
              src={MORPHEUS_MEDIA.beforeAfter}
              alt={t.morpheus_results_title}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
          </article>
        </div>
      </div>
    )}

    {isLashes && (
      <div class="mt-10 space-y-8">
        {/* Video 9:16 centrado */}
        <article class="service-video group relative mx-auto aspect-[9/16] w-full max-w-sm cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)]">
          <video
            class="service-video-media absolute inset-0 h-full w-full object-cover"
            src={LASHES_MEDIA.video}
            poster={LASHES_MEDIA.poster}
            preload="metadata"
            playsinline
            loop
          ></video>
          <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>
        </article>

        {/* 3 imágenes antes/después */}
        <div>
          <h3 class="text-center font-display text-xl font-bold sm:text-2xl">{t.lashes_results_title}</h3>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {LASHES_MEDIA.beforeAfter.map((src) => (
              <article class="relative aspect-square overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-md transition hover:-translate-y-1 hover:shadow-lg">
                <img
                  src={src}
                  alt={t.lashes_results_title}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </article>
            ))}
          </div>
        </div>
      </div>
    )}

    {isSalmon && (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {/* Video 9:16 */}
        <article class="service-video group relative mx-auto aspect-[9/16] w-full max-w-sm cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)]">
          <video
            class="service-video-media absolute inset-0 h-full w-full object-cover"
            src={SALMON_MEDIA.video}
            poster={SALMON_MEDIA.poster}
            preload="metadata"
            playsinline
            loop
          ></video>
          <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>
        </article>

        {/* Imagen */}
        <article class="relative mx-auto aspect-square w-full max-w-sm overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.25)] transition hover:-translate-y-1 hover:shadow-xl">
          <img
            src={SALMON_MEDIA.image}
            alt={t.salmon_image_title}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
        </article>
      </div>
    )}

    {featured && (
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <!-- Featured large video -->
        <article class="service-video group relative col-span-1 aspect-[9/16] cursor-pointer overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_18px_50px_-12px_rgba(107,58,115,0.4)] lg:max-h-[640px]">
          <video
            class="service-video-media absolute inset-0 h-full w-full object-cover"
            src={featured.src}
            poster={featured.poster}
            preload="metadata"
            playsinline
            loop
          ></video>
          {featured.erlym && (
            <span class="absolute left-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-[var(--color-pink-700)] shadow">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-pink-500)]"></span>
              {t.erlym}
            </span>
          )}
          <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>
          <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-[var(--color-plum-900)]/95 via-[var(--color-plum-900)]/55 to-transparent p-5 pt-14">
            <h3 class="font-display text-lg font-bold leading-tight text-white">{featured.title[lang]}</h3>
            <p class="mt-1 text-xs text-white/75">{featured.subtitle[lang]}</p>
          </div>
        </article>

        {(restVideos.length > 0 || verticalVisuals.length > 0) && (
          <div class="grid grid-cols-2 gap-4 lg:col-span-2 lg:grid-cols-3">
            {restVideos.map((v) => (
              <article class="service-video group relative aspect-[9/16] cursor-pointer overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_14px_40px_-12px_rgba(107,58,115,0.4)]">
                <video
                  class="service-video-media absolute inset-0 h-full w-full object-cover"
                  src={v.src}
                  poster={v.poster}
                  preload="none"
                  playsinline
                  loop
                ></video>
                {v.erlym && (
                  <span class="absolute left-2 top-2 z-10 inline-flex items-center gap-1 rounded-full bg-white/95 px-2 py-0.5 text-[9px] font-bold uppercase tracking-widest text-[var(--color-pink-700)] shadow">
                    <span class="h-1 w-1 rounded-full bg-[var(--color-pink-500)]"></span>
                    Erlym
                  </span>
                )}
                <div class="service-video-overlay absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
                  <span class="grid h-12 w-12 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-lg transition group-hover:scale-110">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                </div>
                <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-[var(--color-plum-900)]/95 via-[var(--color-plum-900)]/55 to-transparent p-3 pt-10">
                  <h3 class="font-display text-xs font-bold leading-tight text-white">{v.title[lang]}</h3>
                </div>
              </article>
            ))}

            {/* Imágenes 9:16 — mismo formato que los videos */}
            {verticalVisuals.map((src) => (
              <article class="relative aspect-[9/16] overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-md">
                <img
                  src={src}
                  alt={t.visuals_title}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </article>
            ))}
          </div>
        )}
      </div>
    )}

    {/* Grid cuadrado para imágenes 1:1 — separado para que no se vea raro */}
    {squareVisuals.length > 0 && (
      <div class="mt-12">
        <h3 class="text-center font-display text-xl font-bold sm:text-2xl">{t.visuals_title}</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {squareVisuals.map((src) => (
            <article class="relative aspect-square overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-blush-50)] shadow-md transition hover:-translate-y-1 hover:shadow-lg">
              <img
                src={src}
                alt={t.visuals_title}
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
              />
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".service-video").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>("video.service-video-media");
    const overlay = card.querySelector<HTMLElement>(".service-video-overlay");
    if (!video) return;
    const toggle = async (e: Event) => {
      e.preventDefault();
      if (video.paused) {
        document.querySelectorAll<HTMLVideoElement>(
          ".service-video-media, .reel-media"
        ).forEach((v) => { if (v !== video) { v.pause(); v.muted = true; } });
        video.muted = false;
        video.volume = 0.8;
        try {
          await video.play();
          overlay?.classList.add("hidden");
        } catch {
          video.muted = true;
          try { await video.play(); overlay?.classList.add("hidden"); } catch {}
        }
      } else {
        video.pause();
        overlay?.classList.remove("hidden");
      }
    };
    card.addEventListener("click", toggle);
    video.addEventListener("ended", () => overlay?.classList.remove("hidden"));
  });
</script>
