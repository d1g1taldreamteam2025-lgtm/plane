---
import { getDict, type Lang } from "../i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const items = getDict(lang).trust_badges;

const icons = [
  // Lashes / eye
  `<g fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round">
     <path d="M3 12 Q12 4 21 12"/>
     <circle cx="12" cy="12" r="3.2" fill="#fff" stroke="none"/>
     <path d="M5 7 L4 4 M9 6 L8 3 M15 6 L16 3 M19 7 L20 4"/>
   </g>`,
  // Stars / thumb
  `<g fill="#fff" stroke="#fff" stroke-width="0.8">
     <polygon points="12 3 13.7 8.2 19 8.7 15 12.4 16.3 17.5 12 14.8 7.7 17.5 9 12.4 5 8.7 10.3 8.2"/>
     <polygon points="5 16 5.7 17.6 7.5 17.8 6.2 18.9 6.6 20.5 5 19.6 3.4 20.5 3.8 18.9 2.5 17.8 4.3 17.6" opacity="0.85"/>
     <polygon points="19 16 19.7 17.6 21.5 17.8 20.2 18.9 20.6 20.5 19 19.6 17.4 20.5 17.8 18.9 16.5 17.8 18.3 17.6" opacity="0.85"/>
   </g>`,
  // Certificate / award
  `<g fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
     <rect x="4" y="4" width="16" height="13" rx="2" fill="#fff" stroke="#fff"/>
     <line x1="7"  y1="9"  x2="17" y2="9"  stroke="#ec6f9c"/>
     <line x1="7"  y1="12" x2="14" y2="12" stroke="#ec6f9c"/>
     <circle cx="16" cy="19" r="3" fill="#d4a85a" stroke="#fff"/>
   </g>`,
  // Smile / face
  `<g fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round">
     <circle cx="12" cy="12" r="9" fill="#fff" stroke="none"/>
     <circle cx="9"  cy="10" r="1.2" fill="#1a0f1f"/>
     <circle cx="15" cy="10" r="1.2" fill="#1a0f1f"/>
     <path d="M8 14 Q12 17 16 14" stroke="#ec6f9c"/>
   </g>`,
];
---
<section class="relative -mt-12 z-10 px-5 sm:-mt-16">
  <div class="container-px mx-auto max-w-6xl rounded-3xl border border-[var(--color-line)] bg-white/95 px-5 py-8 shadow-[0_18px_60px_-24px_rgba(107,58,115,0.35)] backdrop-blur sm:px-10 sm:py-10">
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-x-6">
      {items.map((it, i) => (
        <div class="reveal text-center">
          <div class="icon-halo mx-auto">
            <svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i]}></svg>
          </div>
          <h3 class="mt-4 font-display text-sm font-bold sm:text-base">{it.title}</h3>
          <p class="mt-1 text-xs leading-snug text-[var(--color-gray-soft)] sm:text-sm">{it.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
