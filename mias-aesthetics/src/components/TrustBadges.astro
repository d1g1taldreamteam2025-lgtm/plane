---
import { getDict, type Lang } from "../i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const items = getDict(lang).trust_badges;

// Iconos PNG personalizados de la marca en /public/media/
// (recovery post-Cloudinary). Orden alineado con i18n.trust_badges.
// Cuando el cliente los re-suba a esos paths, salen automáticamente.
const icons = [
  "/media/trust-badge-1-tecnica.png",
  "/media/trust-badge-2-google.png",
  "/media/trust-badge-3-productos.png",
  "/media/trust-badge-4-trato.png",
];
---
<section class="relative -mt-12 z-10 px-5 sm:-mt-16">
  <div class="container-px mx-auto max-w-6xl rounded-3xl border border-[var(--color-line)] bg-white/95 px-5 py-8 shadow-[0_18px_60px_-24px_rgba(107,58,115,0.35)] backdrop-blur sm:px-10 sm:py-10">
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-x-6">
      {items.map((it, i) => (
        <div class="reveal text-center">
          <div class="icon-halo mx-auto">
            <img
              src={icons[i]}
              alt={it.title}
              width="96"
              height="96"
              class="h-[68%] w-[68%] object-contain drop-shadow"
              loading="lazy"
            />
          </div>
          <h3 class="mt-5 font-display text-base font-bold sm:text-lg">{it.title}</h3>
          <p class="mt-1.5 text-xs leading-snug text-[var(--color-gray-soft)] sm:text-sm">{it.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
