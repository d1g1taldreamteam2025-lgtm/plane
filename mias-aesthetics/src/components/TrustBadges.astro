---
import { getDict, type Lang } from "../i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const items = getDict(lang).trust_badges;

// Iconos PNG personalizados de la marca (Cloudinary del cliente).
// Orden alineado con i18n.trust_badges: técnica, google, productos, trato.
const icons = [
  "https://res.cloudinary.com/drbc4wbvw/image/upload/v1779412111/Mesa_de_trabajo_1_copia_6_lgvqzq.png",
  "https://res.cloudinary.com/drbc4wbvw/image/upload/v1779412110/Mesa_de_trabajo_1_copia_7_wi2qpk.png",
  "https://res.cloudinary.com/drbc4wbvw/image/upload/v1779412111/Mesa_de_trabajo_1_copia_8_qujqb2.png",
  "https://res.cloudinary.com/drbc4wbvw/image/upload/v1779412110/Mesa_de_trabajo_1_copia_9_mv1l8c.png",
];
---
<section class="relative -mt-12 z-10 px-5 sm:-mt-16">
  <div class="container-px mx-auto max-w-6xl rounded-3xl border border-[var(--color-line)] bg-white/95 px-5 py-8 shadow-[0_18px_60px_-24px_rgba(107,58,115,0.35)] backdrop-blur sm:px-10 sm:py-10">
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-x-6">
      {items.map((it, i) => (
        <div class="reveal text-center">
          <div class="icon-halo mx-auto">
            <img
              src={icons[i]}
              alt={it.title}
              width="180"
              height="180"
              class="h-[160px] w-[160px] max-w-none object-contain drop-shadow sm:h-[190px] sm:w-[190px]"
              loading="lazy"
            />
          </div>
          <h3 class="mt-5 font-display text-base font-bold sm:text-lg">{it.title}</h3>
          <p class="mt-1.5 text-xs leading-snug text-[var(--color-gray-soft)] sm:text-sm">{it.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
