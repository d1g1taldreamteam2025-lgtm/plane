---
import { t, type Lang } from "../i18n";
import { SITE, waLink } from "../lib/site.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const waHref = waLink(lang === "es" ? "Hola Erlym" : "Hi Erlym");
---
<section id="intro" class="relative bg-white py-20 sm:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-20 top-1/3 h-72 w-72 rounded-full bg-[var(--color-blush-100)] opacity-60 blur-3xl"></div>
    <div class="absolute right-0 top-10 h-56 w-56 rounded-full bg-[var(--color-gold-300)] opacity-25 blur-3xl"></div>
  </div>

  <div class="container-px relative mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-12">
    <div class="reveal lg:col-span-7">
      <span class="eyebrow">{t(lang, "intro.eyebrow")}</span>
      <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">
        {t(lang, "intro.title")}
      </h2>
      <p class="mt-6 max-w-2xl text-base text-[var(--color-gray-soft)] sm:text-lg">{t(lang, "intro.p1")}</p>
      <p class="mt-4 max-w-2xl text-base text-[var(--color-gray-soft)] sm:text-lg">{t(lang, "intro.p2")}</p>
      <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary mt-8">
        {lang === "es" ? "Hablá con Erlym" : "Talk to Erlym"}
      </a>
    </div>

    <div class="reveal lg:col-span-5">
      <div class="grid grid-cols-2 gap-4">
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-pink-600)]">500+</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === "es" ? "Clientas" : "Clients"}</div>
        </div>
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-gold-500)]">5.0★</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === "es" ? "Google" : "Google"}</div>
        </div>
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-plum-500)]">15+</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === "es" ? "Tratamientos" : "Treatments"}</div>
        </div>
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-pink-600)]">100%</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === "es" ? "Personalizado" : "Personalized"}</div>
        </div>
      </div>
    </div>
  </div>
</section>
