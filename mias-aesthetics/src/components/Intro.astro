---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section id="intro" class="bg-white py-20 sm:py-28">
  <div class="container-px mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-12">
    <div class="reveal lg:col-span-7">
      <span class="eyebrow">{t(lang, 'intro.eyebrow')}</span>
      <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">
        {t(lang, 'intro.title')}
      </h2>
      <p class="mt-6 max-w-2xl text-base text-[var(--color-gray-soft)] sm:text-lg">
        {t(lang, 'intro.p1')}
      </p>
      <p class="mt-4 max-w-2xl text-base text-[var(--color-gray-soft)] sm:text-lg">
        {t(lang, 'intro.p2')}
      </p>
    </div>
    <div class="reveal lg:col-span-5">
      <div class="grid grid-cols-2 gap-4">
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-rose-600)]">500+</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === 'es' ? 'Clientas' : 'Clients'}</div>
        </div>
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-rose-600)]">5.0★</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === 'es' ? 'Promedio' : 'Average'}</div>
        </div>
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-rose-600)]">15+</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === 'es' ? 'Tratamientos' : 'Treatments'}</div>
        </div>
        <div class="card text-center">
          <div class="font-display text-4xl font-bold text-[var(--color-rose-600)]">100%</div>
          <div class="mt-2 text-xs uppercase tracking-widest text-[var(--color-gray-soft)]">{lang === 'es' ? 'Personalizado' : 'Personalized'}</div>
        </div>
      </div>
    </div>
  </div>
</section>
