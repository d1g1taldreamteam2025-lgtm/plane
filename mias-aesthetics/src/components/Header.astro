---
import LangSwitch from './LangSwitch.astro';
import { t, type Lang } from '../i18n';
import { SITE, waLink } from '../lib/site.ts';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const base = lang === 'en' ? '/en' : '';

const navItems = [
  { key: 'home',         href: `${base}/` },
  { key: 'services',     href: `${base}/#services` },
  { key: 'about',        href: `${base}/#intro` },
  { key: 'testimonials', href: `${base}/#testimonials` },
  { key: 'contact',      href: `${base}/#contact` },
];

const waHref = waLink(lang === 'es'
  ? `Hola Mia's Aesthetics, quisiera reservar una cita.`
  : `Hi Mia's Aesthetics, I'd like to book an appointment.`);
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="container-px mx-auto max-w-7xl">
    <div class="mt-3 flex items-center justify-between rounded-full border border-[var(--color-line)] bg-white/85 px-4 py-2 shadow-[0_6px_24px_-12px_rgba(0,0,0,.15)] backdrop-blur-xl sm:px-5">
      <a href={base + '/'} class="flex items-center gap-2 font-display text-base font-bold tracking-tight sm:text-lg" aria-label={SITE.name}>
        <span class="grid h-8 w-8 place-items-center rounded-full bg-gradient-to-br from-[var(--color-rose-500)] to-[var(--color-rose-400)] text-white">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C9 6 7 9 7 13a5 5 0 0 0 10 0c0-4-2-7-5-11Z"/></svg>
        </span>
        <span>Mia's <span class="text-[var(--color-rose-600)]">Aesthetics</span></span>
      </a>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
        {navItems.map((it) => (
          <a href={it.href} class="text-sm font-medium text-[var(--color-graphite)] transition hover:text-[var(--color-rose-600)]">
            {t(lang, `nav.${it.key}`)}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <LangSwitch lang={lang} path={path} />
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary hidden !px-5 !py-2 !text-xs sm:inline-flex">
          {t(lang, 'nav.book')}
        </a>
        <button id="nav-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-full border border-[var(--color-line)] bg-white text-[var(--color-ink)] lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-nav" class="lg:hidden hidden mt-2 rounded-2xl border border-[var(--color-line)] bg-white/95 p-3 shadow-lg backdrop-blur-xl">
      <nav class="flex flex-col" aria-label="Mobile">
        {navItems.map((it) => (
          <a href={it.href} class="rounded-xl px-4 py-3 text-sm font-medium text-[var(--color-graphite)] transition hover:bg-[var(--color-nude-50)] hover:text-[var(--color-rose-600)]">
            {t(lang, `nav.${it.key}`)}
          </a>
        ))}
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary mt-2 !text-xs">{t(lang, 'nav.book')}</a>
      </nav>
    </div>
  </div>
</header>
<div class="h-20"></div>

<script>
  // Mobile nav toggle
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  // Close on link click
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    nav.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
  }));
  // Shrink-on-scroll
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  #site-header.is-scrolled > div > div {
    box-shadow: 0 12px 32px -16px rgba(0,0,0,.18);
  }
</style>
