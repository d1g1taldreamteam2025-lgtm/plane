---
import LangSwitch from "./LangSwitch.astro";
import { t, type Lang } from "../i18n";
import { SITE, waLink } from "../lib/site.ts";
import { SERVICES } from "../data/services.ts";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const base = lang === "en" ? "/en" : "";

// Lista completa de los 11 servicios desde el catálogo, no del i18n
// (i18n solo tiene 6 para el preview del home).
const servicesPath = lang === "es" ? "servicios" : "services";
const services = SERVICES.map((s) => ({
  slug: s.slugs[lang],
  title: s.title[lang],
  desc: s.shortDesc[lang],
  iconUrl: s.iconUrl,
}));

const coursesPath = lang === "es" ? "cursos" : "courses";

const navItems = [
  { key: "home",         href: `${base}/` },
  { key: "courses",      href: `${base}/${coursesPath}` },
  { key: "about",        href: `${base}/#about` },
  { key: "gallery",      href: `${base}/#gallery` },
  { key: "testimonials", href: `${base}/#testimonials` },
  { key: "contact",      href: `${base}/#contact` },
];

const waHref = waLink(
  lang === "es"
    ? "Hola Mia's Aesthetics, quisiera reservar una cita."
    : "Hi Mia's Aesthetics, I'd like to book an appointment."
);
---
<header id="site-header" class="sticky top-0 z-50 transition-all duration-300">
  <div class="container-px mx-auto max-w-7xl">
    <div class="mt-3 flex items-center justify-between rounded-full border border-[var(--color-line)] bg-white/90 px-4 py-2 shadow-[0_6px_24px_-12px_rgba(107,58,115,.18)] backdrop-blur-xl sm:px-5">
      <a href={base + "/"} class="flex items-center gap-2.5 font-display text-base font-bold tracking-tight sm:text-lg" aria-label={SITE.name}>
        <img src="/LOGO-02.png" alt="" width="64" height="64" class="h-14 w-14 object-contain drop-shadow-[0_4px_14px_rgba(184,138,54,0.45)] sm:h-16 sm:w-16" loading="eager"/>
        <span class="bg-gradient-to-r from-[var(--color-gold-500)] to-[var(--color-pink-600)] bg-clip-text text-transparent">Mia's Aesthetics</span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        <a href={`${base}/`} class="nav-link">{t(lang, "nav.home")}</a>

        <!-- Services dropdown -->
        <div class="relative" data-dropdown>
          <button type="button" class="nav-link flex items-center gap-1.5" aria-haspopup="true" aria-expanded="false">
            {t(lang, "nav.services")}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" class="transition group-data-[open]:rotate-180"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="invisible absolute left-1/2 top-full z-20 mt-2 w-[min(640px,calc(100vw-2rem))] -translate-x-1/2 rounded-2xl border border-[var(--color-line)] bg-white p-3 opacity-0 shadow-[0_18px_50px_-16px_rgba(107,58,115,0.3)] transition-all data-[open]:visible data-[open]:opacity-100">
            <ul class="grid max-h-[70vh] grid-cols-1 gap-1 overflow-y-auto sm:grid-cols-2">
              {services.map((s) => (
                <li>
                  <a
                    href={`${base}/${servicesPath}/${s.slug}`}
                    class="group/item flex items-center gap-3 rounded-xl p-2.5 transition hover:bg-[var(--color-blush-50)]"
                  >
                    {s.iconUrl ? (
                      <img
                        src={s.iconUrl}
                        alt=""
                        width="56"
                        height="56"
                        class="h-14 w-14 flex-shrink-0 object-contain drop-shadow-[0_4px_10px_rgba(212,168,90,0.35)] transition group-hover/item:scale-110"
                        loading="lazy"
                      />
                    ) : (
                      <span class="grid h-14 w-14 flex-shrink-0 place-items-center rounded-full bg-gradient-to-br from-[var(--color-blush-200)] to-[var(--color-pink-500)] text-white">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                      </span>
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="block font-display text-sm font-semibold text-[var(--color-ink)] group-hover/item:text-[var(--color-pink-700)]">{s.title}</span>
                      <span class="mt-0.5 line-clamp-2 block text-xs leading-snug text-[var(--color-gray-soft)]">{s.desc}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={`${base}/#services`} class="mt-3 block rounded-xl bg-[var(--color-ink)] py-2.5 text-center text-xs font-semibold uppercase tracking-widest text-white transition hover:bg-[var(--color-plum-700)]">
              {t(lang, "services_preview.cta_all")}
            </a>
          </div>
        </div>

        {navItems.slice(1).map((it) => (
          <a href={it.href} class="nav-link">{t(lang, `nav.${it.key}`)}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <LangSwitch lang={lang} path={path} />
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary hidden !px-5 !py-2 !text-xs sm:inline-flex">
          {t(lang, "nav.book")}
        </a>
        <button id="nav-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-full border border-[var(--color-line)] bg-white text-[var(--color-ink)] lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-nav" class="lg:hidden hidden mt-2 rounded-2xl border border-[var(--color-line)] bg-white/95 p-3 shadow-lg backdrop-blur-xl">
      <nav class="flex flex-col" aria-label="Mobile">
        <a href={`${base}/`} class="rounded-xl px-4 py-3 text-sm font-medium text-[var(--color-graphite)] transition hover:bg-[var(--color-blush-50)] hover:text-[var(--color-pink-700)]">{t(lang, "nav.home")}</a>
        <details class="group">
          <summary class="flex cursor-pointer items-center justify-between rounded-xl px-4 py-3 text-sm font-medium text-[var(--color-graphite)] transition hover:bg-[var(--color-blush-50)] hover:text-[var(--color-pink-700)]">
            {t(lang, "nav.services")}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" class="transition group-open:rotate-180"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="ml-3 mt-1 flex flex-col border-l border-[var(--color-line)] pl-3">
            {services.map((s) => (
              <a href={`${base}/${servicesPath}/${s.slug}`} class="rounded-lg px-3 py-2 text-sm text-[var(--color-graphite)] hover:text-[var(--color-pink-700)]">{s.title}</a>
            ))}
          </div>
        </details>
        {navItems.slice(1).map((it) => (
          <a href={it.href} class="rounded-xl px-4 py-3 text-sm font-medium text-[var(--color-graphite)] transition hover:bg-[var(--color-blush-50)] hover:text-[var(--color-pink-700)]">{t(lang, `nav.${it.key}`)}</a>
        ))}
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary mt-2 !text-xs">{t(lang, "nav.book")}</a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile nav toggle
  const btn = document.getElementById("nav-toggle");
  const nav = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    const open = nav?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
  nav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
    nav.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
  }));

  // Desktop dropdown (click + hover)
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dd) => {
    const btn = dd.querySelector("button");
    const panel = dd.querySelector<HTMLElement>("div");
    const open = (v: boolean) => {
      dd.toggleAttribute("data-open", v);
      panel?.toggleAttribute("data-open", v);
      btn?.setAttribute("aria-expanded", String(v));
    };
    btn?.addEventListener("click", (e) => { e.preventDefault(); open(!dd.hasAttribute("data-open")); });
    dd.addEventListener("mouseenter", () => open(true));
    dd.addEventListener("mouseleave", () => open(false));
    document.addEventListener("click", (e) => {
      if (!dd.contains(e.target as Node)) open(false);
    });
  });

  // Shrink-on-scroll
  const header = document.getElementById("site-header");
  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 12);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mark active nav link based on current path / hash
  function markActive() {
    const here = location.pathname.replace(/\/$/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>(".nav-link[href]").forEach((a) => {
      const href = a.getAttribute("href") ?? "";
      const target = href.replace(/#.*$/, "").replace(/\/$/, "") || "/";
      const hash = href.includes("#") ? href.slice(href.indexOf("#")) : "";
      const matchesPath = target === here;
      const matchesHash = hash && hash === location.hash;
      a.classList.toggle("active", matchesPath && (!hash || matchesHash));
    });
  }
  markActive();
  window.addEventListener("hashchange", markActive);
</script>

<style>
  #site-header.is-scrolled > div > div {
    box-shadow: 0 12px 32px -16px rgba(107,58,115,.22);
  }
  /* Nav link with animated underline */
  .nav-link {
    position: relative;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-graphite);
    transition: color 0.25s ease;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.35rem;
    height: 2px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--color-pink-500), var(--color-pink-700), var(--color-gold-400));
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(.22,1.2,.36,1), opacity 0.25s ease;
    opacity: 0;
  }
  .nav-link:hover {
    color: var(--color-pink-700);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
    opacity: 1;
  }
  .nav-link.active {
    color: var(--color-pink-700);
  }
  .nav-link.active::after {
    transform: scaleX(1);
    opacity: 1;
  }
</style>
