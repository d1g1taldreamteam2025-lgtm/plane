---
import { t, type Lang } from "../i18n";
import { waLink } from "../lib/site.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const waHref = waLink(
  lang === "es"
    ? "Hola Mia's Aesthetics, quiero mi 15% OFF de bienvenida."
    : "Hi Mia's Aesthetics, I'd like my 15% welcome discount."
);
---
<div
  id="welcome-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="welcome-modal-title"
>
  <div class="overlay-in absolute inset-0 bg-[var(--color-plum-900)]/70 backdrop-blur-sm" data-close></div>

  <div class="modal-in relative w-full max-w-md overflow-hidden rounded-3xl border border-[var(--color-line)] bg-white shadow-2xl sm:max-w-2xl">
    <button
      type="button"
      class="absolute right-3 top-3 z-20 grid h-9 w-9 place-items-center rounded-full bg-white/90 text-[var(--color-graphite)] shadow transition hover:bg-white"
      aria-label="Close"
      data-close
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>

    <div class="grid sm:grid-cols-2">
      <!-- IZQUIERDA: imagen completa SIN recortes. La misma imagen vive
           detrás como fondo borroso para llenar cualquier espacio sin
           que se vean franjas vacías feas (look profesional tipo
           e-commerce premium). -->
      <div class="relative aspect-[5/4] overflow-hidden bg-gradient-to-br from-[var(--color-blush-200)] via-[var(--color-blush-100)] to-[var(--color-gold-300)] sm:aspect-auto">
        <!-- Fondo borroso de la misma imagen -->
        <img
          src="https://res.cloudinary.com/drbc4wbvw/image/upload/f_auto,q_auto,c_limit,w_300,e_blur:600/v1780009037/pesta%C3%B1a_de_oferta_uiqovk.png"
          alt=""
          class="absolute inset-0 h-full w-full scale-110 object-cover object-center opacity-90"
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <!-- Imagen real al frente, completa, sin recortes -->
        <img
          src="https://res.cloudinary.com/drbc4wbvw/image/upload/f_auto,q_auto,c_limit,w_900/v1780009037/pesta%C3%B1a_de_oferta_uiqovk.png"
          alt=""
          class="absolute inset-0 h-full w-full object-contain object-center drop-shadow-[0_8px_24px_rgba(107,58,115,0.35)]"
          loading="lazy"
          decoding="async"
        />
        <!-- Sparkles -->
        <span class="twinkle absolute top-4 left-6 z-10 h-1.5 w-1.5 rounded-full bg-white"></span>
        <span class="twinkle absolute top-10 right-8 z-10 h-2 w-2 rounded-full bg-white" style="animation-delay:0.6s"></span>
        <span class="twinkle absolute bottom-4 left-10 z-10 h-1.5 w-1.5 rounded-full bg-[var(--color-gold-500)]" style="animation-delay:1.2s"></span>
      </div>

      <!-- DERECHA: contenido -->
      <div class="px-5 pb-6 pt-5 text-center sm:flex sm:flex-col sm:justify-center sm:px-7 sm:py-7 sm:text-left">
        <span class="eyebrow eyebrow-gold sm:self-start">{t(lang, "modal.eyebrow")}</span>
        <h2 id="welcome-modal-title" class="h-display mt-4 text-2xl sm:text-3xl">
          {t(lang, "modal.title")}
        </h2>
        <p class="mt-3 text-sm text-[var(--color-gray-soft)] sm:text-base">
          {t(lang, "modal.subtitle")}
        </p>

        <!-- Countdown -->
        <div class="mt-5">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-pink-600)]">
            {t(lang, "modal.countdown_label")}
          </p>
          <div id="countdown" class="mt-2 flex items-center justify-center gap-2 sm:justify-start">
            <div class="flex min-w-[56px] flex-col items-center rounded-xl bg-[var(--color-plum-900)] px-3 py-2 text-white">
              <span class="font-display text-2xl font-bold tabular-nums" data-cd="h">23</span>
              <span class="text-[9px] uppercase tracking-widest opacity-75">{t(lang, "modal.countdown_h")}</span>
            </div>
            <span class="font-display text-2xl font-bold text-[var(--color-plum-900)]">:</span>
            <div class="flex min-w-[56px] flex-col items-center rounded-xl bg-[var(--color-plum-900)] px-3 py-2 text-white">
              <span class="font-display text-2xl font-bold tabular-nums" data-cd="m">59</span>
              <span class="text-[9px] uppercase tracking-widest opacity-75">{t(lang, "modal.countdown_m")}</span>
            </div>
            <span class="font-display text-2xl font-bold text-[var(--color-plum-900)]">:</span>
            <div class="flex min-w-[56px] flex-col items-center rounded-xl bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-pink-600)] px-3 py-2 text-white">
              <span class="font-display text-2xl font-bold tabular-nums" data-cd="s">59</span>
              <span class="text-[9px] uppercase tracking-widest opacity-90">{t(lang, "modal.countdown_s")}</span>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-2 sm:flex-row">
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.49 0 .2 5.3.2 11.86c0 2.09.55 4.13 1.6 5.93L0 24l6.36-1.67a11.84 11.84 0 0 0 5.69 1.45h.01c6.56 0 11.86-5.3 11.86-11.86 0-3.17-1.23-6.15-3.4-8.44Z"/></svg>
            {t(lang, "modal.cta")}
          </a>
          <button type="button" class="btn btn-outline" data-close>{t(lang, "modal.dismiss")}</button>
        </div>
        <p class="mt-5 text-[10px] uppercase tracking-widest text-[var(--color-gray-soft)]">
          {t(lang, "modal.fine_print")}
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Floating sticker / FAB para invocar el descuento -->
<button
  id="discount-fab"
  type="button"
  class="fixed bottom-5 left-5 z-30 hidden sm:bottom-6 sm:left-6"
  aria-label={t(lang, "modal.title")}
>
  <span class="discount-fab-pulse"></span>
  <span class="relative grid h-20 w-20 place-items-center rounded-full text-center text-white shadow-[0_18px_40px_-10px_rgba(208,75,126,0.55)] transition hover:scale-110"
        style="background: radial-gradient(circle at 30% 30%, #ff9bbf 0%, #ec6f9c 55%, #a83861 100%);">
    <span class="leading-tight">
      <span class="block font-display text-xl font-extrabold">15%</span>
      <span class="block text-[10px] font-bold uppercase tracking-widest">OFF</span>
    </span>
  </span>
  <!-- bow on top -->
  <svg class="absolute -top-2 left-1/2 -translate-x-1/2 rotate-[-10deg]" width="32" height="20" viewBox="0 0 36 24" aria-hidden="true">
    <defs>
      <linearGradient id="fab-bow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ffc6dd"/>
        <stop offset="100%" stop-color="#d04b7e"/>
      </linearGradient>
    </defs>
    <path d="M18 12 L4 4 Q1 6 1 12 Q1 18 4 20 L18 12Z" fill="url(#fab-bow)" stroke="#fff" stroke-width="1"/>
    <path d="M18 12 L32 4 Q35 6 35 12 Q35 18 32 20 L18 12Z" fill="url(#fab-bow)" stroke="#fff" stroke-width="1"/>
    <circle cx="18" cy="12" r="3.5" fill="#a83861" stroke="#fff" stroke-width="1"/>
  </svg>
</button>

<style>
  .discount-fab-pulse {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgba(236, 111, 156, 0.55);
    animation: fabPulse 2s cubic-bezier(.22,1.2,.36,1) infinite;
    z-index: 0;
  }
  @keyframes fabPulse {
    0%   { transform: scale(1);   opacity: 0.6; }
    70%  { transform: scale(1.4); opacity: 0; }
    100% { transform: scale(1.4); opacity: 0; }
  }
  @keyframes fabIn {
    from { opacity: 0; transform: scale(0.4) translateY(20px); }
    to   { opacity: 1; transform: scale(1)   translateY(0); }
  }
  #discount-fab.show {
    display: block;
    animation: fabIn 0.5s cubic-bezier(.22,1.2,.36,1) forwards;
  }
</style>

<script>
  const STORAGE_KEY    = "mia_welcome_modal_shown";
  const DEADLINE_KEY   = "mia_welcome_deadline";
  const DURATION_MS    = 24 * 60 * 60 * 1000; // 24h

  const modal = document.getElementById("welcome-modal");
  const fab   = document.getElementById("discount-fab");
  if (modal) {
    const showFab = () => fab?.classList.add("show");
    const hideFab = () => fab?.classList.remove("show");
    const open = () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      hideFab();
      startCountdown();
    };
    const close = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      sessionStorage.setItem(STORAGE_KEY, "1");
      // Después de cerrar mostramos el FAB para que pueda re-abrirlo cuando quiera
      setTimeout(showFab, 600);
    };
    modal.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) close();
    });
    fab?.addEventListener("click", open);

    // Countdown logic — persists deadline across reloads
    let timer: number | null = null;
    function getDeadline(): number {
      const stored = Number(localStorage.getItem(DEADLINE_KEY) || 0);
      if (stored > Date.now()) return stored;
      const fresh = Date.now() + DURATION_MS;
      localStorage.setItem(DEADLINE_KEY, String(fresh));
      return fresh;
    }
    function pad(n: number) { return n < 10 ? `0${n}` : String(n); }
    function startCountdown() {
      if (timer) return;
      const deadline = getDeadline();
      const tick = () => {
        const ms = Math.max(0, deadline - Date.now());
        const h  = Math.floor(ms / 3_600_000);
        const m  = Math.floor((ms % 3_600_000) / 60_000);
        const s  = Math.floor((ms % 60_000) / 1000);
        document.querySelector("[data-cd='h']")!.textContent = pad(h);
        document.querySelector("[data-cd='m']")!.textContent = pad(m);
        document.querySelector("[data-cd='s']")!.textContent = pad(s);
        if (ms <= 0 && timer) { clearInterval(timer); timer = null; }
      };
      tick();
      timer = window.setInterval(tick, 1000);
    }

    if (!sessionStorage.getItem(STORAGE_KEY)) {
      setTimeout(open, 5000);
    } else {
      // Si ya cerró el modal en esta sesión, mostramos directo el FAB
      setTimeout(showFab, 1500);
    }
  }
</script>
