---
import { t, type Lang } from '../i18n';
import { waLink } from '../lib/site.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const href = waLink(lang === 'es'
  ? `Hola Mia's Aesthetics, me gustaría más info.`
  : `Hi Mia's Aesthetics, I'd like more info.`);
---
<a href={href} target="_blank" rel="noopener"
   aria-label={t(lang, 'whatsapp_float_aria')}
   class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_12px_32px_-8px_rgba(37,211,102,.55)] transition hover:scale-110 hover:bg-[#1ebd5a] sm:bottom-6 sm:right-6 sm:h-16 sm:w-16">
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.49 0 .2 5.3.2 11.86c0 2.09.55 4.13 1.6 5.93L0 24l6.36-1.67a11.84 11.84 0 0 0 5.69 1.45h.01c6.56 0 11.86-5.3 11.86-11.86 0-3.17-1.23-6.15-3.4-8.44Zm-8.47 18.27c-1.79 0-3.55-.48-5.08-1.39l-.36-.22-3.77.99 1-3.68-.24-.38a9.86 9.86 0 0 1-1.51-5.21c0-5.46 4.44-9.9 9.91-9.9 2.65 0 5.13 1.03 7 2.9a9.84 9.84 0 0 1 2.9 7c-.01 5.47-4.45 9.89-9.85 9.89Zm5.42-7.41c-.3-.15-1.76-.87-2.04-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.74-1.64-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.3.17-1.41-.07-.12-.27-.2-.57-.34Z"/>
