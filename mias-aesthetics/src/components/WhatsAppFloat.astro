---
import { t, type Lang } from "../i18n";
import { SITE, waLink } from "../lib/site.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const href = waLink(
  lang === "es"
    ? "Hola Mia's Aesthetics, me gustaría más info."
    : "Hi Mia's Aesthetics, I'd like more info."
);
---
<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t(lang, "whatsapp_float_aria")}
  class="group fixed bottom-5 right-5 z-40 grid h-16 w-16 place-items-center rounded-full bg-[#25D366] shadow-[0_12px_32px_-8px_rgba(37,211,102,.55)] transition hover:scale-110 hover:bg-[#1ebd5a] sm:bottom-6 sm:right-6 sm:h-[68px] sm:w-[68px]"
>
  <span class="absolute inset-0 rounded-full pulse-ring"></span>

  <!-- Pink bow on top -->
  <svg
    class="absolute -top-3 left-1/2 -translate-x-1/2 rotate-[-8deg] drop-shadow-[0_2px_3px_rgba(0,0,0,0.25)]"
    width="36" height="24" viewBox="0 0 36 24" aria-hidden="true"
  >
    <defs>
      <linearGradient id="bow-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ffc6dd"/>
        <stop offset="100%" stop-color="#ec6f9c"/>
      </linearGradient>
    </defs>
    <path d="M18 12 L4 4 Q1 6 1 12 Q1 18 4 20 L18 12Z" fill="url(#bow-grad)" stroke="#fff" stroke-width="1"/>
    <path d="M18 12 L32 4 Q35 6 35 12 Q35 18 32 20 L18 12Z" fill="url(#bow-grad)" stroke="#fff" stroke-width="1"/>
    <circle cx="18" cy="12" r="3.5" fill="#d04b7e" stroke="#fff" stroke-width="1"/>
  </svg>

  <img src={SITE.icons.whatsapp} alt="WhatsApp" width="36" height="36" class="h-9 w-9 drop-shadow" loading="lazy" />
</a>
