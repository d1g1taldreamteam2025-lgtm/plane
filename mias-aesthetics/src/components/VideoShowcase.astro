---
import { type Lang } from "../i18n";
import { REELS } from "../data/reels.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const eyebrow  = lang === "es" ? "Tratamientos en video" : "Treatments in video";
const title    = lang === "es" ? "Ven a ver lo que hacemos" : "Come see what we do";
const subtitle = lang === "es"
  ? "Reels reales del estudio. Toca cualquier card para reproducir con sonido."
  : "Real reels from the studio. Tap any card to play with sound.";
const erlymLabel = lang === "es" ? "Erlym en cámara" : "Erlym on camera";
const prevLabel = lang === "es" ? "Anterior" : "Previous";
const nextLabel = lang === "es" ? "Siguiente" : "Next";
const swipeHint = lang === "es" ? "Desliza con el dedo para ver más" : "Swipe to see more";
---
<section id="reels" class="relative overflow-hidden bg-gradient-to-b from-[var(--color-blush-50)] via-white to-[var(--color-cream)] py-20 sm:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 -left-20 h-[440px] w-[440px] rounded-full bg-[var(--color-blush-100)] opacity-50 blur-3xl"></div>
    <div class="absolute -bottom-20 -right-20 h-[360px] w-[360px] rounded-full bg-[var(--color-gold-300)] opacity-25 blur-3xl"></div>
  </div>

  <div class="container-px relative mx-auto max-w-7xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow eyebrow-gold">{eyebrow}</span>
      <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">{title}</h2>
      <p class="mt-4 text-base text-[var(--color-gray-soft)] sm:text-lg">{subtitle}</p>
      <p class="mt-2 inline-flex items-center gap-2 text-xs text-[var(--color-pink-600)] sm:hidden">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
        {swipeHint}
      </p>
    </div>
  </div>

  <!-- Scroller con flechas grandes a los lados -->
  <div class="reveal relative mt-10">
    <button
      id="reels-prev"
      type="button"
      class="absolute left-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-[var(--color-line)] bg-white text-[var(--color-ink)] shadow-lg transition hover:scale-110 hover:bg-[var(--color-blush-50)] sm:left-4 sm:grid lg:h-14 lg:w-14"
      aria-label={prevLabel}
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <button
      id="reels-next"
      type="button"
      class="absolute right-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-blush-400)] text-white shadow-xl transition hover:scale-110 sm:right-4 sm:grid lg:h-14 lg:w-14"
      aria-label={nextLabel}
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-white to-transparent sm:w-16"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-[var(--color-cream)] to-transparent sm:w-16"></div>

    <div id="reels-scroller" class="reels-scroller flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-smooth px-3 pb-6 sm:gap-5 sm:px-20 lg:px-24">
      {REELS.map((r, i) => (
        <article
          class="reel-card group relative aspect-[9/16] w-[240px] flex-shrink-0 cursor-pointer snap-center overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-plum-900)] shadow-[0_14px_40px_-12px_rgba(107,58,115,0.4)] transition hover:-translate-y-1 sm:w-[260px] lg:w-[280px]"
          data-idx={i}
        >
          <video
            class="reel-media absolute inset-0 h-full w-full object-cover"
            src={r.src}
            poster={r.poster}
            preload="none"
            playsinline
            loop
            data-src={r.src}
          ></video>

          {r.erlym && (
            <span class="absolute left-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-[var(--color-pink-700)] shadow">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-pink-500)]"></span>
              {erlymLabel}
            </span>
          )}
          <span class="absolute right-3 top-3 z-10 grid h-7 w-7 place-items-center rounded-full bg-black/55 text-white backdrop-blur">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          </span>

          <div class="reel-play absolute inset-0 z-10 grid place-items-center transition group-hover:bg-black/15">
            <span class="grid h-16 w-16 place-items-center rounded-full bg-white/95 text-[var(--color-pink-700)] shadow-xl transition group-hover:scale-110">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>

          <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-[var(--color-plum-900)]/95 via-[var(--color-plum-900)]/55 to-transparent p-4 pt-12">
            <h3 class="font-display text-base font-bold leading-tight text-white">{r.title[lang]}</h3>
            <p class="mt-1 text-xs text-white/75">{r.subtitle[lang]}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reels-scroller::-webkit-scrollbar { display: none; }
  .reels-scroller { scrollbar-width: none; }
</style>

<script>
  const scroller = document.getElementById("reels-scroller");
  const prevBtn  = document.getElementById("reels-prev");
  const nextBtn  = document.getElementById("reels-next");
  if (scroller) {
    const step = () => {
      const card = scroller.querySelector<HTMLElement>(".reel-card");
      return card ? card.offsetWidth + 20 : 280;
    };
    prevBtn?.addEventListener("click", () => scroller.scrollBy({ left: -step(), behavior: "smooth" }));
    nextBtn?.addEventListener("click", () => scroller.scrollBy({ left:  step(), behavior: "smooth" }));

    // Click-to-play inline con sonido
    scroller.querySelectorAll<HTMLElement>(".reel-card").forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>("video.reel-media");
      const overlay = card.querySelector<HTMLElement>(".reel-play");
      if (!video) return;
      const togglePlay = async (e: Event) => {
        e.preventDefault();
        if (video.paused) {
          // Pausar otros
          scroller.querySelectorAll<HTMLVideoElement>("video.reel-media").forEach((v) => {
            if (v !== video) { v.pause(); v.muted = true; }
          });
          video.muted = false;
          video.volume = 0.8;
          try {
            await video.play();
            overlay?.classList.add("hidden");
          } catch {
            // Si el navegador no permite autoplay con sonido, intentamos muted
            video.muted = true;
            try { await video.play(); overlay?.classList.add("hidden"); } catch {}
          }
        } else {
          video.pause();
          overlay?.classList.remove("hidden");
        }
      };
      card.addEventListener("click", togglePlay);
      video.addEventListener("ended", () => overlay?.classList.remove("hidden"));
    });
  }
</script>
