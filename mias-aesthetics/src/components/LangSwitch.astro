---
import { t, type Lang } from '../i18n';
import { SITE } from '../lib/site.ts';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;

const cleanPath = path.replace(/^\/en/, '') || '/';
const esHref = cleanPath;
const enHref = cleanPath === '/' ? '/en' : `/en${cleanPath}`;
---
<div class="inline-flex items-center gap-1 rounded-full border border-[var(--color-line)] bg-white/80 p-1 backdrop-blur" role="group" aria-label={t(lang, 'lang_switch_aria')}>
  <a
    href={esHref}
    class:list={[
      'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold tracking-wider transition',
      lang === 'es' ? 'bg-[var(--color-ink)] text-white' : 'text-[var(--color-gray-soft)] hover:bg-[var(--color-blush-50)] hover:text-[var(--color-ink)]'
    ]}
    aria-current={lang === 'es' ? 'page' : undefined}
  >
    <img src={SITE.icons.flagEs} alt="" width="18" height="13" class="h-3 w-[18px] rounded-[2px] object-cover ring-1 ring-black/10" loading="lazy"/>
    <span>ES</span>
  </a>
  <a
    href={enHref}
    class:list={[
      'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold tracking-wider transition',
      lang === 'en' ? 'bg-[var(--color-ink)] text-white' : 'text-[var(--color-gray-soft)] hover:bg-[var(--color-blush-50)] hover:text-[var(--color-ink)]'
    ]}
    aria-current={lang === 'en' ? 'page' : undefined}
  >
    <img src={SITE.icons.flagEn} alt="" width="18" height="13" class="h-3 w-[18px] rounded-[2px] object-cover ring-1 ring-black/10" loading="lazy"/>
    <span>EN</span>
  </a>
</div>
