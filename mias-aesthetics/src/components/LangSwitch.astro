---
import { t, type Lang } from '../i18n';
import { SITE } from '../lib/site.ts';
import { SERVICES } from '../data/services.ts';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;

// Resolver bien la URL del otro idioma: si estamos en una página de servicio,
// mapeamos el slug. Si no, simplemente cambiamos el prefijo.
function otherPath(currentPath: string, currentLang: Lang): string {
  // Servicio en español → buscar equivalente en inglés
  const mEs = currentPath.match(/^\/servicios\/(.+?)\/?$/);
  if (mEs && currentLang === 'es') {
    const svc = SERVICES.find((s) => s.slugs.es === mEs[1]);
    return svc ? `/en/services/${svc.slugs.en}` : '/en';
  }
  const mEn = currentPath.match(/^\/en\/services\/(.+?)\/?$/);
  if (mEn && currentLang === 'en') {
    const svc = SERVICES.find((s) => s.slugs.en === mEn[1]);
    return svc ? `/servicios/${svc.slugs.es}` : '/';
  }
  // Default: home toggle
  if (currentLang === 'es') {
    return currentPath === '/' ? '/en' : `/en${currentPath}`;
  }
  return currentPath.replace(/^\/en/, '') || '/';
}

const esHref = lang === 'es' ? path : otherPath(path, lang);
const enHref = lang === 'en' ? path : otherPath(path, lang);
---
<div class="inline-flex items-center gap-1 rounded-full border border-[var(--color-line)] bg-white/80 p-1 backdrop-blur" role="group" aria-label={t(lang, 'lang_switch_aria')}>
  <a
    href={esHref}
    class:list={[
      'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold tracking-wider transition',
      lang === 'es' ? 'bg-[var(--color-ink)] text-white' : 'text-[var(--color-gray-soft)] hover:bg-[var(--color-blush-50)] hover:text-[var(--color-ink)]'
    ]}
    aria-current={lang === 'es' ? 'page' : undefined}
  >
    <img src={SITE.icons.flagEs} alt="" width="18" height="13" class="h-3 w-[18px] rounded-[2px] object-cover ring-1 ring-black/10" loading="lazy"/>
    <span>ES</span>
  </a>
  <a
    href={enHref}
    class:list={[
      'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold tracking-wider transition',
      lang === 'en' ? 'bg-[var(--color-ink)] text-white' : 'text-[var(--color-gray-soft)] hover:bg-[var(--color-blush-50)] hover:text-[var(--color-ink)]'
    ]}
    aria-current={lang === 'en' ? 'page' : undefined}
  >
    <img src={SITE.icons.flagEn} alt="" width="18" height="13" class="h-3 w-[18px] rounded-[2px] object-cover ring-1 ring-black/10" loading="lazy"/>
    <span>EN</span>
  </a>
</div>
