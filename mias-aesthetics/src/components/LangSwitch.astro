---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;

const cleanPath = path.replace(/^\/en/, '') || '/';
const esHref = cleanPath;
const enHref = cleanPath === '/' ? '/en' : `/en${cleanPath}`;
---
<div class="inline-flex items-center gap-0.5 rounded-full border border-[var(--color-line)] bg-white/80 p-0.5 backdrop-blur" role="group" aria-label={t(lang, 'lang_switch_aria')}>
  <a
    href={esHref}
    class:list={[
      'rounded-full px-3 py-1 text-xs font-semibold tracking-wider transition',
      lang === 'es' ? 'bg-[var(--color-ink)] text-white' : 'text-[var(--color-gray-soft)] hover:text-[var(--color-ink)]'
    ]}
    aria-current={lang === 'es' ? 'page' : undefined}
  >ES</a>
  <a
    href={enHref}
    class:list={[
      'rounded-full px-3 py-1 text-xs font-semibold tracking-wider transition',
      lang === 'en' ? 'bg-[var(--color-ink)] text-white' : 'text-[var(--color-gray-soft)] hover:text-[var(--color-ink)]'
    ]}
    aria-current={lang === 'en' ? 'page' : undefined}
  >EN</a>
</div>
