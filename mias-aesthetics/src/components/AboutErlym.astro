---
import { t, getDict, type Lang } from "../i18n";
import { waLink } from "../lib/site.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const dict = getDict(lang).about_erlym;
const waHref = waLink(lang === "es" ? "Hola Erlym, quisiera consultarte algo." : "Hi Erlym, I have a question.");
---
<section id="about" class="relative overflow-hidden bg-white py-20 sm:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-32 top-0 h-96 w-96 rounded-full bg-[var(--color-blush-100)] opacity-60 blur-3xl"></div>
    <div class="absolute -right-20 bottom-10 h-72 w-72 rounded-full bg-[var(--color-gold-300)] opacity-25 blur-3xl"></div>
  </div>

  <div class="container-px relative mx-auto max-w-7xl">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- PORTRAIT PLACEHOLDER -->
      <div class="reveal lg:col-span-5">
        <div class="relative mx-auto aspect-[4/5] w-full max-w-md">
          <!-- decorative dashed circle -->
          <div class="absolute -inset-3 rounded-[2.5rem] border-2 border-dashed border-[var(--color-gold-400)] opacity-50"></div>
          <div class="absolute inset-0 rotate-2 rounded-[2rem] bg-gradient-to-br from-[var(--color-pink-500)] via-[var(--color-blush-400)] to-[var(--color-gold-400)] opacity-25"></div>

          <!-- portrait card -->
          <div class="absolute inset-1 overflow-hidden rounded-[1.85rem] bg-gradient-to-br from-[var(--color-blush-100)] via-white to-[var(--color-blush-200)] shadow-2xl">
            <img
              src="https://res.cloudinary.com/drbc4wbvw/image/upload/v1779353797/Captura_de_pantalla_2026-05-21_035619_rzdzga.png"
              alt="Erlym Monasterios — fundadora de Mia's Aesthetics"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />

            <!-- bottom label -->
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[var(--color-plum-900)]/85 via-[var(--color-plum-900)]/50 to-transparent p-5">
              <div class="font-display text-lg font-bold text-white">Erlym Monasterios</div>
              <div class="text-xs uppercase tracking-widest text-white/75">{lang === "es" ? "Fundadora · Técnica certificada" : "Founder · Certified technician"}</div>
            </div>
          </div>

          <!-- floating signature badge -->
          <div class="absolute -bottom-5 -right-5 rotate-6 rounded-2xl border border-[var(--color-line)] bg-white p-3 shadow-xl">
            <div class="flex items-center gap-2">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-blush-400)] text-white">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C9 6 7 9 7 13a5 5 0 0 0 10 0c0-4-2-7-5-11Z"/></svg>
              </span>
              <div>
                <div class="font-display text-sm font-bold leading-tight">Mia's Aesthetics</div>
                <div class="text-[10px] uppercase tracking-widest text-[var(--color-gray-soft)]">Anaheim, CA</div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- BIO -->
      <div class="reveal lg:col-span-7">
        <span class="eyebrow eyebrow-gold">{dict.eyebrow}</span>
        <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">{dict.title}</h2>
        <p class="mt-5 text-base text-[var(--color-gray-soft)] sm:text-lg">{dict.subtitle}</p>

        <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-graphite)]">
          <p>{dict.p1}</p>
          <p>{dict.p2}</p>
          <p>{dict.p3}</p>
        </div>

        <!-- Values -->
        <div class="mt-10">
          <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-pink-600)]">{dict.values_title}</h3>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {dict.values.map((v) => (
              <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-blush-50)] p-4">
                <div class="font-display text-sm font-bold">{v.title}</div>
                <p class="mt-1 text-xs leading-snug text-[var(--color-gray-soft)]">{v.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Stats -->
        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {dict.stats.map((s, i) => (
            <div class={`rounded-2xl border border-[var(--color-line)] p-4 text-center ${i === 1 ? "bg-gradient-to-br from-[var(--color-blush-100)] to-white" : "bg-white"}`}>
              <div class="font-display text-2xl font-bold text-[var(--color-pink-600)] sm:text-3xl">{s.n}</div>
              <div class="mt-1 text-[10px] uppercase tracking-widest text-[var(--color-gray-soft)]">{s.label}</div>
            </div>
          ))}
        </div>

        <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary mt-8">
          {dict.cta}
        </a>
      </div>
    </div>
  </div>
</section>
