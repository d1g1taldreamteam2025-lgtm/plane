---
import { t, getDict, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const items = getDict(lang).why.items;
---
<section class="bg-white py-20 sm:py-28">
  <div class="container-px mx-auto max-w-7xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">{t(lang, 'why.eyebrow')}</span>
      <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">
        {t(lang, 'why.title')}
      </h2>
    </div>

    <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-2">
      {items.map((it, i) => (
        <div class="reveal flex gap-5">
          <div class="flex-shrink-0">
            <div class="grid h-12 w-12 place-items-center rounded-full border-2 border-[var(--color-rose-400)] font-display text-lg font-bold text-[var(--color-rose-600)]">
              0{i + 1}
            </div>
          </div>
          <div>
            <h3 class="font-display text-lg font-bold">{it.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-gray-soft)]">{it.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
