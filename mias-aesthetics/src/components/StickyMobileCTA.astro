---
import { type Lang } from "../i18n";
import { SITE, waLink, telLink } from "../lib/site.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const waHref = waLink(
  lang === "es"
    ? "Hola Mia's Aesthetics, quisiera reservar."
    : "Hi Mia's Aesthetics, I'd like to book."
);
const tel = telLink();
const waLabel  = lang === "es" ? "WhatsApp" : "WhatsApp";
const callLabel = lang === "es" ? "Llamar" : "Call";
const noteWa = lang === "es" ? "Respuesta inmediata" : "Instant reply";
const noteCall = lang === "es" ? "Lun-Sáb · 9 a 19" : "Mon-Sat · 9-7";
---
<aside
  id="sticky-mobile-cta"
  class="fixed inset-x-0 bottom-0 z-40 grid translate-y-full grid-cols-2 gap-px border-t border-[var(--color-line)] bg-white shadow-[0_-12px_32px_-12px_rgba(107,58,115,0.25)] transition-transform duration-300 lg:hidden"
  aria-hidden="true"
>
  <a
    href={waHref}
    target="_blank"
    rel="noopener"
    class="flex items-center justify-center gap-2 bg-[#25D366] px-3 py-3 text-white"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.49 0 .2 5.3.2 11.86c0 2.09.55 4.13 1.6 5.93L0 24l6.36-1.67a11.84 11.84 0 0 0 5.69 1.45h.01c6.56 0 11.86-5.3 11.86-11.86 0-3.17-1.23-6.15-3.4-8.44Z"/></svg>
    <div class="flex flex-col items-start leading-tight">
      <span class="font-display text-sm font-bold uppercase tracking-wider">{waLabel}</span>
      <span class="text-[10px] opacity-90">{noteWa}</span>
    </div>
  </a>

  <a
    href={tel}
    class="flex items-center justify-center gap-2 bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-pink-600)] px-3 py-3 text-white"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <div class="flex flex-col items-start leading-tight">
      <span class="font-display text-sm font-bold uppercase tracking-wider">{callLabel}</span>
      <span class="text-[10px] opacity-90">{SITE.phoneDisplay}</span>
    </div>
  </a>
</aside>

<script>
  const cta = document.getElementById("sticky-mobile-cta");
  if (cta) {
    const handle = () => {
      const show = window.scrollY > 600;
      cta.classList.toggle("translate-y-full", !show);
      cta.setAttribute("aria-hidden", String(!show));
    };
    handle();
    window.addEventListener("scroll", handle, { passive: true });
  }
</script>
