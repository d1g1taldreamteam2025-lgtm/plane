---
import { t, type Lang } from '../i18n';
import { SITE, waLink } from '../lib/site.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const year = new Date().getFullYear();
const hours = SITE.hours[lang];

const nav = [
  { key: 'home',         href: `${base}/` },
  { key: 'services',     href: `${base}/#services` },
  { key: 'about',        href: `${base}/#intro` },
  { key: 'testimonials', href: `${base}/#testimonials` },
];

const waHref = waLink(lang === 'es' ? `Hola Mia's Aesthetics` : `Hi Mia's Aesthetics`);
---
<footer class="bg-[var(--color-ink)] text-white">
  <div class="container-px mx-auto max-w-7xl py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href={base + '/'} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-gradient-to-br from-[var(--color-rose-500)] to-[var(--color-rose-400)]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C9 6 7 9 7 13a5 5 0 0 0 10 0c0-4-2-7-5-11Z"/></svg>
          </span>
          Mia's <span class="text-[var(--color-rose-300)]">Aesthetics</span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-white/60">{t(lang, 'footer.tagline')}</p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white/80">{t(lang, 'footer.explore')}</h3>
        <ul class="mt-5 space-y-3 text-sm text-white/70">
          {nav.map((it) => (
            <li><a class="transition hover:text-[var(--color-rose-300)]" href={it.href}>{t(lang, `nav.${it.key}`)}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white/80">{t(lang, 'footer.contact_title')}</h3>
        <ul class="mt-5 space-y-3 text-sm text-white/70">
          <li>
            <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition hover:text-[var(--color-rose-300)]">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.49 0 .2 5.3.2 11.86c0 2.09.55 4.13 1.6 5.93L0 24l6.36-1.67a11.84 11.84 0 0 0 5.69 1.45h.01c6.56 0 11.86-5.3 11.86-11.86 0-3.17-1.23-6.15-3.4-8.44Z"/></svg>
              {SITE.whatsappDisplay}
            </a>
          </li>
          <li><a href={`mailto:${SITE.email}`} class="transition hover:text-[var(--color-rose-300)]">{SITE.email}</a></li>
          <li class="pt-2 text-xs uppercase tracking-widest text-white/40">{lang === 'es' ? 'Horarios' : 'Hours'}</li>
          {hours.map((h) => (
            <li class="flex justify-between gap-3 text-xs text-white/60"><span>{h.day}</span><span>{h.time}</span></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white/80">{t(lang, 'footer.follow')}</h3>
        <a href={SITE.instagram} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-3 text-sm text-white/70 transition hover:text-[var(--color-rose-300)]">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-white/10">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </span>
          {SITE.instagramHandle}
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row sm:items-center">
      <p>© {year} {SITE.name}. {t(lang, 'footer.rights')}</p>
      <div class="flex items-center gap-4">
        <a href="#" class="transition hover:text-white">{t(lang, 'footer.legal.privacy')}</a>
        <a href="#" class="transition hover:text-white">{t(lang, 'footer.legal.terms')}</a>
      </div>
    </div>
  </div>
</footer>
