---
import { t, type Lang } from "../i18n";
import { SITE, waLink } from "../lib/site.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = lang === "en" ? "/en" : "";
const year = new Date().getFullYear();
const hours = SITE.hours[lang];

const nav = [
  { key: "home",         href: `${base}/` },
  { key: "services",     href: `${base}/#services` },
  { key: "about",        href: `${base}/#intro` },
  { key: "testimonials", href: `${base}/#testimonials` },
];

const waHref = waLink(lang === "es" ? "Hola Mia's Aesthetics" : "Hi Mia's Aesthetics");

const socials = [
  { name: "Instagram",   href: SITE.social.instagram,   icon: "https://res.cloudinary.com/drbc4wbvw/image/upload/v1778897809/Google_Maps_icon__2026.svg_waaes9.webp" },
  { name: "Facebook",    href: SITE.social.facebook,    icon: SITE.icons.facebook },
  { name: "TikTok",      href: SITE.social.tiktok,      icon: SITE.icons.tiktok },
  { name: "Google Maps", href: SITE.social.googleMaps,  icon: SITE.icons.googleMaps },
];
---
<footer class="relative overflow-hidden bg-[var(--color-plum-900)] text-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-20 -left-20 h-72 w-72 rounded-full bg-[var(--color-pink-700)] opacity-30 blur-3xl"></div>
    <div class="absolute -bottom-32 -right-20 h-96 w-96 rounded-full bg-[var(--color-plum-500)] opacity-25 blur-3xl"></div>
  </div>

  <div class="container-px relative mx-auto max-w-7xl py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href={base + "/"} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-blush-400)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C9 6 7 9 7 13a5 5 0 0 0 10 0c0-4-2-7-5-11Z"/></svg>
          </span>
          Mia's <span class="text-[var(--color-blush-300)]">Aesthetics</span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-white/65">{t(lang, "footer.tagline")}</p>
        <p class="mt-2 text-xs text-white/45">by {SITE.owner}</p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white/80">{t(lang, "footer.explore")}</h3>
        <ul class="mt-5 space-y-3 text-sm text-white/70">
          {nav.map((it) => (
            <li><a class="transition hover:text-[var(--color-blush-300)]" href={it.href}>{t(lang, `nav.${it.key}`)}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white/80">{t(lang, "footer.contact_title")}</h3>
        <ul class="mt-5 space-y-3 text-sm text-white/75">
          <li>
            <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition hover:text-[var(--color-blush-300)]">
              <img src={SITE.icons.whatsapp} alt="" width="18" height="18" class="h-[18px] w-[18px]" loading="lazy"/>
              {SITE.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 transition hover:text-[var(--color-blush-300)]">
              <img src={SITE.icons.gmail} alt="" width="18" height="18" class="h-[18px] w-[18px]" loading="lazy"/>
              <span class="break-all text-xs">{SITE.email}</span>
            </a>
          </li>
          <li>
            <a href={SITE.social.googleMaps} target="_blank" rel="noopener" class="inline-flex items-start gap-2 transition hover:text-[var(--color-blush-300)]">
              <img src={SITE.icons.googleMaps} alt="" width="18" height="18" class="mt-0.5 h-[18px] w-[18px]" loading="lazy"/>
              <span class="text-xs">{SITE.address}</span>
            </a>
          </li>
          <li class="pt-3 text-xs uppercase tracking-widest text-white/40">{lang === "es" ? "Horarios" : "Hours"}</li>
          {hours.map((h) => (
            <li class="flex justify-between gap-3 text-xs text-white/60"><span>{h.day}</span><span>{h.time}</span></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-white/80">{t(lang, "footer.follow")}</h3>
        <div class="mt-5 grid grid-cols-4 gap-2 sm:grid-cols-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="group flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 p-2.5 transition hover:border-white/20 hover:bg-white/10"
              aria-label={s.name}
              title={s.name}
            >
              <img src={s.icon} alt="" width="22" height="22" class="h-5 w-5 transition group-hover:scale-110" loading="lazy"/>
              <span class="hidden text-xs font-medium text-white/80 sm:inline">{s.name}</span>
            </a>
          ))}
        </div>
        <p class="mt-4 text-xs text-white/50">{SITE.social.instagramHandle}</p>
      </div>
    </div>

    <!-- Payment methods -->
    <div class="mt-14 border-t border-white/10 pt-8">
      <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
        <div>
          <h3 class="font-display text-xs font-semibold uppercase tracking-widest text-white/70">{t(lang, "footer.payments_title")}</h3>
          <p class="mt-1 text-xs text-white/50">{t(lang, "footer.payments_note")}</p>
        </div>
        <ul class="flex flex-wrap items-center justify-center gap-2.5">
          {SITE.payments.map((pm) => (
            <li class="grid h-10 w-16 place-items-center rounded-lg bg-white px-2.5 shadow-md" title={pm.name}>
              <img src={pm.icon} alt={pm.name} width="56" height="24" class="max-h-6 w-auto object-contain" loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row sm:items-center">
      <p>© {year} {SITE.name}. {t(lang, "footer.rights")}</p>
      <div class="flex items-center gap-4">
        <a href="#" class="transition hover:text-white">{t(lang, "footer.legal.privacy")}</a>
        <a href="#" class="transition hover:text-white">{t(lang, "footer.legal.terms")}</a>
      </div>
    </div>
  </div>
</footer>
