---
import { t, type Lang } from "../i18n";
import { SITE, waLink } from "../lib/site.ts";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const hours = SITE.hours[lang];

const mapEmbed =
  "https://maps.google.com/maps?q=" +
  encodeURIComponent(SITE.address) +
  "&t=&z=15&ie=UTF8&iwloc=&output=embed";

const waHref = waLink(
  lang === "es"
    ? "Hola Mia's Aesthetics, quisiera reservar una cita."
    : "Hi Mia's Aesthetics, I'd like to book an appointment."
);
---
<section id="contact" class="relative bg-gradient-to-b from-white via-[var(--color-blush-50)] to-white py-20 sm:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute right-0 top-10 h-72 w-72 rounded-full bg-[var(--color-gold-300)] opacity-20 blur-3xl"></div>
    <div class="absolute left-0 bottom-10 h-72 w-72 rounded-full bg-[var(--color-blush-200)] opacity-40 blur-3xl"></div>
  </div>

  <div class="container-px relative mx-auto max-w-7xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">{t(lang, "contact_section.eyebrow")}</span>
      <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">
        {t(lang, "contact_section.title")}
      </h2>
      <p class="mt-5 text-base text-[var(--color-gray-soft)] sm:text-lg">
        {t(lang, "contact_section.subtitle")}
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-5">
      <!-- Info card -->
      <div class="reveal lg:col-span-2">
        <div class="card flex h-full flex-col">
          <ul class="space-y-5">
            <li class="flex items-start gap-4">
              <img
                src="https://res.cloudinary.com/dehvpdo4z/image/upload/v1779650180/Mesa_de_trabajo_1_copia_15_zwafkq.png"
                alt=""
                width="56"
                height="56"
                class="h-14 w-14 flex-shrink-0 object-contain drop-shadow-[0_4px_10px_rgba(212,168,90,0.30)]"
                loading="lazy"
              />
              <div>
                <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-pink-600)]">{t(lang, "contact_section.address_label")}</h3>
                <p class="mt-1 text-sm leading-relaxed text-[var(--color-graphite)]">{SITE.address}</p>
                <a
                  href={SITE.social.googleMaps}
                  target="_blank"
                  rel="noopener"
                  class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-[var(--color-pink-600)] hover:gap-2.5 transition-all"
                >
                  {t(lang, "contact_section.directions")}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4 border-t border-[var(--color-line)] pt-5">
              <img
                src="https://res.cloudinary.com/dehvpdo4z/image/upload/v1779650225/Mesa_de_trabajo_1_copia_14_iqtaso.png"
                alt=""
                width="56"
                height="56"
                class="h-14 w-14 flex-shrink-0 object-contain drop-shadow-[0_4px_10px_rgba(212,168,90,0.30)]"
                loading="lazy"
              />
              <div>
                <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-pink-600)]">{t(lang, "contact_section.phone_label")}</h3>
                <a href={waHref} target="_blank" rel="noopener" class="mt-1 block font-display text-lg font-bold text-[var(--color-ink)] hover:text-[var(--color-pink-700)] transition-colors">
                  {SITE.whatsappDisplay}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4 border-t border-[var(--color-line)] pt-5">
              <img
                src="https://res.cloudinary.com/dehvpdo4z/image/upload/v1779650279/Mesa_de_trabajo_1_copia_13_fqjin3.png"
                alt=""
                width="56"
                height="56"
                class="h-14 w-14 flex-shrink-0 object-contain drop-shadow-[0_4px_10px_rgba(212,168,90,0.30)]"
                loading="lazy"
              />
              <div class="min-w-0">
                <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-pink-600)]">{t(lang, "contact_section.email_label")}</h3>
                <a href={`mailto:${SITE.email}`} class="mt-1 block break-all text-sm text-[var(--color-graphite)] hover:text-[var(--color-pink-700)] transition-colors">
                  {SITE.email}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4 border-t border-[var(--color-line)] pt-5">
              <img
                src="https://res.cloudinary.com/dehvpdo4z/image/upload/v1779650179/Mesa_de_trabajo_1_copia_12_pnnfgy.png"
                alt=""
                width="56"
                height="56"
                class="h-14 w-14 flex-shrink-0 object-contain drop-shadow-[0_4px_10px_rgba(212,168,90,0.30)]"
                loading="lazy"
              />
              <div class="flex-1">
                <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-pink-600)]">{t(lang, "contact_section.hours_label")}</h3>
                <ul class="mt-1 space-y-1">
                  {hours.map((h) => (
                    <li class="flex justify-between gap-3 text-sm text-[var(--color-graphite)]">
                      <span>{h.day}</span>
                      <span class="font-medium">{h.time}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          </ul>

          <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp mt-6">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.49 0 .2 5.3.2 11.86c0 2.09.55 4.13 1.6 5.93L0 24l6.36-1.67a11.84 11.84 0 0 0 5.69 1.45h.01c6.56 0 11.86-5.3 11.86-11.86 0-3.17-1.23-6.15-3.4-8.44Z"/></svg>
            {t(lang, "cta_final.cta")}
          </a>
        </div>
      </div>

      <!-- Map -->
      <div class="reveal lg:col-span-3">
        <div class="relative h-full min-h-[420px] overflow-hidden rounded-3xl border border-[var(--color-line)] shadow-[0_18px_50px_-16px_rgba(107,58,115,0.25)]">
          <iframe
            src={mapEmbed}
            title={SITE.address}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 h-full w-full"
            style="border:0;"
          ></iframe>
          <a
            href={SITE.social.googleMaps}
            target="_blank"
            rel="noopener"
            class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-semibold uppercase tracking-widest text-[var(--color-ink)] shadow-lg transition hover:scale-105"
          >
            <img src={SITE.icons.googleMaps} alt="" width="16" height="16" class="h-4 w-4" loading="lazy"/>
            {t(lang, "contact_section.open_in_maps")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
