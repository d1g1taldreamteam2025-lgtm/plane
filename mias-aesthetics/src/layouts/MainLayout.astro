---
import "../styles/global.css";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import WelcomeModal from "../components/WelcomeModal.astro";
import ActivityPopup from "../components/ActivityPopup.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { t, type Lang } from "../i18n";
import { SITE } from "../lib/site.ts";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  path?: string;
  showWelcomeModal?: boolean;
  extraJsonLd?: object[];
}

const { lang, title, description, path = "/", showWelcomeModal = true, extraJsonLd = [] } = Astro.props;

const pageTitle = title ?? t(lang, "meta.title");
const pageDesc = description ?? t(lang, "meta.description");
const canonical = new URL(path, Astro.site ?? SITE.url).toString();
const altEs = new URL(path.replace(/^\/en/, "") || "/", Astro.site ?? SITE.url).toString();
const altEn = new URL("/en" + (path === "/" ? "" : path), Astro.site ?? SITE.url).toString();

// LocalBusiness / BeautySalon schema con horarios estructurados + geo + ratings
const openingSpec = SITE.hoursStruct.map((h) => ({
  "@type": "OpeningHoursSpecification",
  dayOfWeek: ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"][h.day],
  opens: h.open,
  closes: h.close,
}));

const businessJsonLd = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  "@id": `${SITE.url}/#business`,
  name: SITE.name,
  url: SITE.url,
  image: `${SITE.url}/og-image.png`,
  logo: `${SITE.url}/favicon.svg`,
  description: pageDesc,
  address: {
    "@type": "PostalAddress",
    streetAddress: "5031 E Orangethorpe Ave unit g",
    addressLocality: "Anaheim",
    addressRegion: "CA",
    postalCode: "92807",
    addressCountry: "US",
  },
  geo: { "@type": "GeoCoordinates", latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  hasMap: SITE.social.googleMaps,
  openingHoursSpecification: openingSpec,
  sameAs: [SITE.social.instagram, SITE.social.facebook, SITE.social.tiktok, SITE.social.googleMaps],
  telephone: SITE.phone,
  email: SITE.email,
  priceRange: "$$",
  paymentAccepted: ["Cash", "Credit Card", "Zelle", "Visa", "Mastercard", "American Express"],
  founder: { "@type": "Person", name: SITE.owner },
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.9", reviewCount: "6" },
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: SITE.url,
  name: SITE.name,
  inLanguage: lang === "es" ? "es-US" : "en-US",
};

const allJsonLd = [businessJsonLd, websiteJsonLd, ...extraJsonLd];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#ec6f9c" />
  <meta name="generator" content={Astro.generator} />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />

  <link rel="alternate" hreflang="es" href={altEs} />
  <link rel="alternate" hreflang="en" href={altEn} />
  <link rel="alternate" hreflang="x-default" href={altEs} />

  <!-- Favicon: logo oficial Mia's Aesthetics (PNG real subido al repo) -->
  <link rel="icon" type="image/png" href={`/LOGO-02.png?v=${Date.now()}`} />
  <link rel="apple-touch-icon" href="/LOGO-02.png" />
  <link rel="preconnect" href="https://res.cloudinary.com" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

  <!-- Geo meta for local SEO -->
  <meta name="geo.region" content="US-CA" />
  <meta name="geo.placename" content="Anaheim" />
  <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
  <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${SITE.url}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === "es" ? "es_US" : "en_US"} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={`${SITE.url}/og-image.png`} />

  {allJsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
</head>
<body class="bg-white text-[var(--color-ink)]">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[999] focus:rounded-full focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:text-white">
    {t(lang, "skip_to_content")}
  </a>
  <AnnouncementBar lang={lang} />
  <Header lang={lang} path={path} />
  <main id="main" class="pb-16 lg:pb-0">
    <slot />
  </main>
  <Footer lang={lang} />
  <WhatsAppFloat lang={lang} />
  <StickyMobileCTA lang={lang} />
  <ActivityPopup lang={lang} />
  <WelcomeModal lang={lang} />
  <CookieBanner lang={lang} />

  <script>
    const els = document.querySelectorAll<HTMLElement>(".reveal");
    if (els.length && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add("in"));
    }
  </script>
</body>
</html>
