---
import MainLayout from "../../../layouts/MainLayout.astro";
import { getDict, t } from "../../../i18n";
import { waLink, SITE } from "../../../lib/site.ts";

export function getStaticPaths() {
  const items = getDict("en").services_preview.items;
  return items.map((it) => ({ params: { slug: it.slug }, props: { item: it } }));
}

const { slug } = Astro.params;
const { item } = Astro.props as { item: { slug: string; title: string; desc: string } };
const lang = "en" as const;

const waHref = waLink(`Hi Mia's Aesthetics, I'd like info about ${item.title}.`);
const others = getDict(lang).services_preview.items.filter((s) => s.slug !== slug);
---
<MainLayout
  lang={lang}
  path={`/en/services/${slug}`}
  title={`${item.title} — Mia's Aesthetics`}
  description={item.desc}
  showWelcomeModal={false}
>
  <section class="relative overflow-hidden bg-gradient-to-br from-[var(--color-blush-50)] via-white to-[var(--color-blush-100)] py-20 sm:py-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-20 -left-20 h-96 w-96 rounded-full bg-[var(--color-blush-100)] opacity-60 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-20 h-[28rem] w-[28rem] rounded-full bg-[var(--color-gold-300)] opacity-25 blur-3xl"></div>
    </div>
    <div class="container-px relative mx-auto max-w-5xl">
      <nav class="text-xs uppercase tracking-widest text-[var(--color-gray-soft)]" aria-label="breadcrumb">
        <a href="/en/" class="hover:text-[var(--color-pink-600)]">{t(lang, "nav.home")}</a>
        <span class="mx-2">/</span>
        <a href="/en/#services" class="hover:text-[var(--color-pink-600)]">{t(lang, "nav.services")}</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-pink-700)]">{item.title}</span>
      </nav>

      <span class="eyebrow mt-8 inline-block">{t(lang, "services_preview.eyebrow")}</span>
      <h1 class="h-display mt-5 text-[clamp(2.5rem,6vw,4rem)]">{item.title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-[var(--color-gray-soft)]">{item.desc}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp">
          <img src={SITE.icons.whatsapp} alt="" width="18" height="18" class="h-[18px] w-[18px]" loading="lazy"/>
          {t(lang, "cta_final.cta")}
        </a>
        <a href="/en/#services" class="btn btn-outline">← {t(lang, "nav.services")}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container-px mx-auto max-w-5xl">
      <div class="grid gap-10 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="h-display text-2xl sm:text-3xl">What's included?</h2>
          <p class="mt-4 text-base leading-relaxed text-[var(--color-gray-soft)]">
            Full service details — technique, products, estimated duration, pre &amp; post care tips, pricing and before/after gallery — coming soon.
          </p>
          <p class="mt-3 text-base leading-relaxed text-[var(--color-gray-soft)]">
            In the meantime, message us on WhatsApp and Erlym will personally answer all your questions.
          </p>

          <ul class="mt-8 space-y-3 text-sm text-[var(--color-graphite)]">
            <li class="flex items-start gap-3">
              <span class="mt-1 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-[var(--color-pink-500)] text-white">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Personalized consultation
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-[var(--color-pink-500)] text-white">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Treatment with professional products
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-[var(--color-pink-500)] text-white">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Aftercare recommendations
            </li>
          </ul>
        </div>

        <aside class="rounded-3xl border border-[var(--color-line)] bg-gradient-to-br from-[var(--color-blush-50)] to-white p-6 shadow-sm">
          <h3 class="font-display text-lg font-bold">Book your appointment</h3>
          <p class="mt-2 text-sm text-[var(--color-gray-soft)]">We reply on WhatsApp within minutes.</p>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-primary mt-5 w-full">
            {t(lang, "cta_final.cta")}
          </a>
          <p class="mt-4 border-t border-[var(--color-line)] pt-4 text-xs text-[var(--color-gray-soft)]">
            {SITE.address}
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-cream)] py-16">
    <div class="container-px mx-auto max-w-5xl">
      <h2 class="h-display text-2xl sm:text-3xl">Other services</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {others.map((o) => (
          <a href={`/en/services/${o.slug}`} class="card group flex flex-col">
            <h3 class="font-display text-lg font-bold group-hover:text-[var(--color-pink-700)]">{o.title}</h3>
            <p class="mt-2 flex-1 text-sm text-[var(--color-gray-soft)]">{o.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-[var(--color-pink-600)] group-hover:gap-2">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
