---
import MainLayout from "../../../layouts/MainLayout.astro";
import { t } from "../../../i18n";
import { waLink, SITE } from "../../../lib/site.ts";
import { SERVICES, findServiceBySlug } from "../../../data/services.ts";

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slugs.en }, props: { id: s.id } }));
}

const { slug } = Astro.params;
const lang = "en" as const;
const svc = findServiceBySlug(slug!, lang)!;
const p = svc.palette;

const waHref = waLink(`Hi Mia's Aesthetics, I'd like info about ${svc.title.en}.`);

const others = SERVICES.filter((s) => s.id !== svc.id).slice(0, 3);
---
<MainLayout
  lang={lang}
  path={`/en/services/${slug}`}
  title={`${svc.title.en} in Anaheim, CA — Mia's Aesthetics`}
  description={svc.shortDesc.en}
  showWelcomeModal={false}
>
  <section
    class="relative overflow-hidden py-20 sm:py-28"
    style={`background: linear-gradient(135deg, ${p.from} 0%, ${p.to} 100%);`}
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-32 -left-20 h-[440px] w-[440px] rounded-full bg-white opacity-30 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 h-[480px] w-[480px] rounded-full bg-white opacity-25 blur-3xl"></div>
      <span class="twinkle absolute top-[20%] left-[10%] h-2 w-2 rounded-full bg-white"></span>
      <span class="twinkle absolute bottom-[18%] right-[12%] h-3 w-3 rounded-full bg-white" style="animation-delay:0.8s"></span>
    </div>

    <div class="container-px relative mx-auto max-w-7xl" style={`color: ${p.text};`}>
      <nav class="text-xs uppercase tracking-widest opacity-80" aria-label="breadcrumb">
        <a href="/en/" class="hover:opacity-100">Home</a>
        <span class="mx-2">/</span>
        <a href="/en/#services" class="hover:opacity-100">Services</a>
        <span class="mx-2">/</span>
        <span class="opacity-100">{svc.title.en}</span>
      </nav>

      <div class="mt-8 grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="inline-block rounded-full bg-white/20 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest backdrop-blur">
            {t(lang, "services_preview.eyebrow")}
          </span>
          <h1 class="h-display mt-5 text-[clamp(2.5rem,6vw,4.5rem)]" style={`color: ${p.text};`}>
            {svc.title.en}
          </h1>
          <p class="mt-5 max-w-2xl text-lg opacity-90 sm:text-xl">{svc.tagline.en}</p>

          <div class="mt-8 flex flex-wrap items-center gap-4 text-sm font-semibold">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
              {svc.duration.en}
            </span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              {svc.priceFrom.en}
            </span>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp">
              <img src={SITE.icons.whatsapp} alt="" width="18" height="18" class="h-[18px] w-[18px]" loading="lazy"/>
              Book on WhatsApp
            </a>
            <a href="/en/#services" class="btn !bg-white/20 !text-white hover:!bg-white hover:!text-[var(--color-ink)]">← Other services</a>
          </div>
        </div>

        <div class="hidden lg:col-span-5 lg:block">
          <div class="float-y mx-auto aspect-square w-full max-w-md rounded-3xl border border-white/30 bg-white/15 p-8 backdrop-blur">
            <div class="grid h-full place-items-center rounded-2xl border-2 border-dashed border-white/40">
              <div class="text-center">
                <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="mx-auto opacity-80" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <p class="mt-4 text-xs uppercase tracking-widest opacity-90">Photo coming soon</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="container-px mx-auto grid max-w-6xl gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <span class="eyebrow">About the treatment</span>
        <h2 class="h-display mt-5 text-[clamp(1.75rem,3.5vw,2.5rem)]">{svc.shortDesc.en}</h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-gray-soft)]">
          {svc.longDesc.en.map((para) => <p>{para}</p>)}
        </div>

        <h3 class="mt-12 font-display text-xl font-bold">What's included</h3>
        <ul class="mt-5 space-y-3">
          {svc.includes.en.map((it) => (
            <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
              <span class="mt-0.5 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-blush-400)] text-white">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {it}
            </li>
          ))}
        </ul>
      </div>

      <aside class="self-start lg:sticky lg:top-28">
        <div class="rounded-3xl border border-[var(--color-line)] bg-gradient-to-br from-[var(--color-blush-50)] to-white p-6 shadow-md">
          <span class="eyebrow eyebrow-gold">Book</span>
          <h3 class="mt-3 font-display text-lg font-bold">Your visit in Anaheim</h3>
          <ul class="mt-5 space-y-3 text-sm">
            <li class="flex items-center justify-between border-b border-[var(--color-line)] pb-3">
              <span class="text-[var(--color-gray-soft)]">Duration</span>
              <span class="font-semibold">{svc.duration.en}</span>
            </li>
            <li class="flex items-center justify-between border-b border-[var(--color-line)] pb-3">
              <span class="text-[var(--color-gray-soft)]">Price</span>
              <span class="font-semibold">{svc.priceFrom.en}</span>
            </li>
            <li class="text-xs leading-snug text-[var(--color-gray-soft)]">{svc.priceNote.en}</li>
          </ul>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp mt-5 w-full">
            Book on WhatsApp
          </a>
          <p class="mt-4 border-t border-[var(--color-line)] pt-3 text-xs text-[var(--color-gray-soft)]">
            {SITE.address}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[var(--color-cream)] py-20">
    <div class="container-px mx-auto max-w-6xl">
      <div class="text-center">
        <span class="eyebrow">Care</span>
        <h2 class="h-display mt-5 text-[clamp(1.75rem,3.5vw,2.5rem)]">Before and after</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-[var(--color-blush-100)] text-[var(--color-pink-600)]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold">Before the treatment</h3>
          </div>
          <ul class="mt-5 space-y-3">
            {svc.preCare.en.map((it) => (
              <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-pink-500)]"></span>
                {it}
              </li>
            ))}
          </ul>
        </div>
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-[var(--color-blush-100)] text-[var(--color-pink-600)]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold">After the treatment</h3>
          </div>
          <ul class="mt-5 space-y-3">
            {svc.postCare.en.map((it) => (
              <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-pink-500)]"></span>
                {it}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {svc.faqs.en.length > 0 && (
    <section class="bg-white py-20">
      <div class="container-px mx-auto max-w-3xl">
        <div class="text-center">
          <span class="eyebrow eyebrow-gold">FAQ</span>
          <h2 class="h-display mt-5 text-[clamp(1.75rem,3.5vw,2.5rem)]">What people ask the most</h2>
        </div>
        <div class="mt-10 space-y-3">
          {svc.faqs.en.map((faq) => (
            <details class="group rounded-2xl border border-[var(--color-line)] bg-white p-5 transition hover:shadow-md">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-display font-semibold">
                {faq.q}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" class="text-[var(--color-pink-600)] transition group-open:rotate-45">
                  <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-gray-soft)]">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-[var(--color-cream)] py-20">
    <div class="container-px mx-auto max-w-6xl">
      <h2 class="h-display text-2xl sm:text-3xl">Other services</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {others.map((o) => {
          const op = o.palette;
          return (
            <a href={`/en/services/${o.slugs.en}`} class="card group flex flex-col">
              <div
                class="h-1.5 w-12 rounded-full"
                style={`background: linear-gradient(90deg, ${op.from}, ${op.to});`}
              ></div>
              <h3 class="mt-4 font-display text-lg font-bold group-hover:text-[var(--color-pink-700)]">{o.title.en}</h3>
              <p class="mt-2 flex-1 text-sm text-[var(--color-gray-soft)]">{o.shortDesc.en}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-[var(--color-pink-600)] group-hover:gap-2">
                Learn more →
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>
