---
import MainLayout from "../../layouts/MainLayout.astro";
import { COURSES } from "../../data/courses.ts";
import { SITE, waLink } from "../../lib/site.ts";

const lang = "es" as const;
const waHref = waLink("Hola Mia's Aesthetics, quisiera info de los cursos.");
---
<MainLayout
  lang={lang}
  path="/cursos"
  title="Cursos Mia Academy — Aprende belleza con Erlym Monasterios"
  description="Cursos profesionales de pestañas, faciales y BB Glow en Anaheim, CA. Programa Mia Academy con certificado oficial y kit profesional incluido."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[var(--color-plum-700)] via-[var(--color-plum-900)] to-[var(--color-pink-700)] py-20 sm:py-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-20 -left-20 h-96 w-96 rounded-full bg-[var(--color-pink-500)] opacity-25 blur-3xl"></div>
      <div class="absolute -bottom-20 -right-20 h-[28rem] w-[28rem] rounded-full bg-[var(--color-gold-400)] opacity-20 blur-3xl"></div>
      <span class="twinkle absolute top-[18%] left-[12%] h-2 w-2 rounded-full bg-white"></span>
      <span class="twinkle absolute bottom-[20%] right-[14%] h-3 w-3 rounded-full bg-[var(--color-gold-300)]" style="animation-delay:0.8s"></span>
    </div>

    <div class="container-px relative mx-auto max-w-4xl text-center">
      <span class="inline-block rounded-full bg-white/15 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-[var(--color-gold-300)] backdrop-blur">
        Mia Academy
      </span>
      <h1 class="h-display mt-5 text-[clamp(2rem,7vw,4.5rem)] text-white">
        Aprende belleza<br/>
        <span class="bg-gradient-to-r from-[var(--color-gold-300)] via-[var(--color-gold-400)] to-[var(--color-blush-300)] bg-clip-text italic text-transparent">
          con Erlym.
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base text-white/80 sm:text-lg">
        Cursos presenciales en Anaheim, CA. Más de 20 años de experiencia
        condensados en programas intensivos. Certificado oficial, kit
        profesional y mentoría incluidos.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp">
          <img src={SITE.icons.whatsapp} alt="" width="18" height="18" class="h-[18px] w-[18px]" loading="lazy"/>
          Consultar fechas
        </a>
        <a href="#courses" class="btn !bg-white/15 !text-white hover:!bg-white hover:!text-[var(--color-ink)]">Ver cursos</a>
      </div>
    </div>
  </section>

  <!-- COURSES GRID -->
  <section id="courses" class="bg-[var(--color-cream)] py-20 sm:py-28">
    <div class="container-px mx-auto max-w-7xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow eyebrow-gold">Programas</span>
        <h2 class="h-display mt-5 text-[clamp(2rem,4.5vw,3.25rem)]">5 caminos para profesionalizarte</h2>
        <p class="mt-5 text-base text-[var(--color-gray-soft)] sm:text-lg">
          Cada curso tiene cupos limitados y kit incluido. Reserva tu lugar por WhatsApp.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {COURSES.map((c) => {
          const p = c.palette;
          return (
            <article class="card reveal group flex flex-col">
              <!-- Visual placeholder -->
              <div
                class="relative aspect-[4/3] overflow-hidden rounded-2xl"
                style={`background: linear-gradient(135deg, ${p.from}, ${p.to});`}
              >
                {c.cover ? (
                  <img src={c.cover} alt={c.title.es} class="absolute inset-0 h-full w-full object-cover" loading="lazy"/>
                ) : (
                  <div class="absolute inset-0 grid place-items-center">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style={`color: ${p.text}`} aria-hidden="true">
                      <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                      <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                    </svg>
                  </div>
                )}
                <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-[var(--color-pink-700)] shadow">
                  {c.level.es}
                </span>
              </div>

              <h3 class="mt-5 font-display text-xl font-bold">{c.title.es}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-gray-soft)]">{c.tagline.es}</p>

              <ul class="mt-4 space-y-1.5 text-xs text-[var(--color-graphite)]">
                <li class="flex items-center gap-2">
                  <span class="text-[var(--color-pink-600)]">⏱</span> {c.duration.es}
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[var(--color-pink-600)]">📍</span> {c.modality.es}
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[var(--color-pink-600)]">💎</span> {c.priceFrom.es}
                </li>
              </ul>

              <a href={`/cursos/${c.slugs.es}`} class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-[var(--color-pink-600)] transition group-hover:gap-3">
                Ver detalle
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container-px mx-auto max-w-5xl">
      <div class="overflow-hidden rounded-3xl border border-[var(--color-line)] shadow-[0_18px_50px_-16px_rgba(107,58,115,0.25)]">
        <div class="relative aspect-video bg-black">
          <iframe
            src="https://www.youtube.com/embed/VuhKSIOh_jA"
            title="Mia Academy"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
            class="absolute inset-0 h-full w-full"
            style="border:0;"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
