---
import MainLayout from "../../layouts/MainLayout.astro";
import { waLink, SITE } from "../../lib/site.ts";
import { COURSES, findCourseBySlug } from "../../data/courses.ts";

export function getStaticPaths() {
  return COURSES.map((c) => ({ params: { slug: c.slugs.es }, props: { id: c.id } }));
}

const { slug } = Astro.params;
const lang = "es" as const;
const c = findCourseBySlug(slug!, lang)!;
const p = c.palette;

const waHref = waLink(`Hola Mia's Aesthetics, quisiera reservar el curso "${c.title.es}".`);
const others = COURSES.filter((o) => o.id !== c.id).slice(0, 3);

const pageUrl = `${SITE.url}/cursos/${slug}`;

const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: c.title.es,
  description: c.shortDesc.es + " " + c.longDesc.es[0],
  provider: {
    "@type": "Organization",
    name: SITE.name,
    sameAs: SITE.url,
  },
  url: pageUrl,
  inLanguage: "es-US",
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "in-person",
    location: {
      "@type": "Place",
      name: SITE.name,
      address: SITE.address,
    },
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    price: c.priceFrom.es.match(/\$?[\d,]+/)?.[0]?.replace(/[^\d.]/g, "") ?? undefined,
    availability: "https://schema.org/InStock",
    url: pageUrl,
  },
};
---
<MainLayout
  lang={lang}
  path={`/cursos/${slug}`}
  title={`${c.title.es} — Mia Academy`}
  description={c.tagline.es}
  showWelcomeModal={false}
  extraJsonLd={[courseJsonLd]}
>
  <!-- HERO -->
  <section
    class="relative overflow-hidden py-20 sm:py-28"
    style={`background: linear-gradient(135deg, ${p.from} 0%, ${p.to} 100%); color: ${p.text};`}
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-32 -left-20 h-[440px] w-[440px] rounded-full bg-white opacity-25 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 h-[480px] w-[480px] rounded-full bg-white opacity-20 blur-3xl"></div>
    </div>

    <div class="container-px relative mx-auto max-w-7xl">
      <nav class="text-xs uppercase tracking-widest opacity-80" aria-label="breadcrumb">
        <a href="/" class="hover:opacity-100">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/cursos" class="hover:opacity-100">Cursos</a>
        <span class="mx-2">/</span>
        <span class="opacity-100">{c.title.es}</span>
      </nav>

      <div class="mt-8 grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="inline-block rounded-full bg-white/20 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest backdrop-blur">
            Mia Academy · {c.level.es}
          </span>
          <h1 class="h-display mt-5 text-[clamp(2.5rem,6vw,4.5rem)]" style={`color: ${p.text}`}>
            {c.title.es}
          </h1>
          <p class="mt-5 max-w-2xl text-lg opacity-90 sm:text-xl">{c.tagline.es}</p>

          <div class="mt-8 flex flex-wrap items-center gap-3 text-sm font-semibold">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur">⏱ {c.duration.es}</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur">📍 {c.modality.es}</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur">💎 {c.priceFrom.es}</span>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp">
              <img src={SITE.icons.whatsapp} alt="" width="18" height="18" class="h-[18px] w-[18px]" loading="lazy"/>
              Reservar cupo
            </a>
            <a href="/cursos" class="btn !bg-white/20 !text-white hover:!bg-white hover:!text-[var(--color-ink)]">← Todos los cursos</a>
          </div>

          <p class="mt-6 text-xs uppercase tracking-widest opacity-75">{c.nextDate.es}</p>
        </div>

        <!-- Video / Visual placeholder -->
        <div class="hidden lg:col-span-5 lg:block">
          {c.videoEmbed ? (
            <div class="aspect-video overflow-hidden rounded-3xl border border-white/30 bg-black shadow-2xl">
              <iframe
                src={c.videoEmbed}
                title={c.title.es}
                class="h-full w-full"
                frameborder="0"
                allow="autoplay; fullscreen"
                allowfullscreen
              ></iframe>
            </div>
          ) : (
            <div class="float-y mx-auto aspect-[4/5] w-full max-w-md rounded-3xl border border-white/30 bg-white/15 p-8 backdrop-blur">
              <div class="grid h-full place-items-center rounded-2xl border-2 border-dashed border-white/40">
                <div class="text-center">
                  <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="mx-auto opacity-80" aria-hidden="true">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                  <p class="mt-4 text-xs uppercase tracking-widest opacity-90">Video tutorial próximamente</p>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- LONG DESC + LEARN -->
  <section class="bg-white py-20">
    <div class="container-px mx-auto grid max-w-6xl gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <span class="eyebrow">Sobre el curso</span>
        <h2 class="h-display mt-5 text-[clamp(1.75rem,3.5vw,2.5rem)]">{c.shortDesc.es}</h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-gray-soft)]">
          {c.longDesc.es.map((para) => <p>{para}</p>)}
        </div>

        <h3 class="mt-12 font-display text-xl font-bold">¿Qué aprenderás?</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {c.learn.es.map((it) => (
            <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
              <span class="mt-0.5 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-blush-400)] text-white">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {it}
            </li>
          ))}
        </ul>

        <h3 class="mt-12 font-display text-xl font-bold">¿Para quién es?</h3>
        <ul class="mt-5 space-y-2.5">
          {c.whoFor.es.map((it) => (
            <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
              <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-pink-500)]"></span>
              {it}
            </li>
          ))}
        </ul>
      </div>

      <!-- BOOKING ASIDE -->
      <aside class="self-start lg:sticky lg:top-28">
        <div class="rounded-3xl border border-[var(--color-line)] bg-gradient-to-br from-[var(--color-blush-50)] to-white p-6 shadow-md">
          <span class="eyebrow eyebrow-gold">Reservar</span>
          <h3 class="mt-3 font-display text-lg font-bold">Asegura tu cupo</h3>
          <ul class="mt-5 space-y-3 text-sm">
            <li class="flex items-center justify-between border-b border-[var(--color-line)] pb-3">
              <span class="text-[var(--color-gray-soft)]">Duración</span>
              <span class="font-semibold">{c.duration.es}</span>
            </li>
            <li class="flex items-center justify-between border-b border-[var(--color-line)] pb-3">
              <span class="text-[var(--color-gray-soft)]">Nivel</span>
              <span class="font-semibold">{c.level.es}</span>
            </li>
            <li class="flex items-center justify-between border-b border-[var(--color-line)] pb-3">
              <span class="text-[var(--color-gray-soft)]">Precio</span>
              <span class="font-semibold">{c.priceFrom.es}</span>
            </li>
            <li class="text-xs leading-snug text-[var(--color-gray-soft)]">{c.priceNote.es}</li>
            <li class="text-xs leading-snug text-[var(--color-pink-700)] font-semibold">{c.nextDate.es}</li>
          </ul>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp mt-5 w-full">
            Reservar por WhatsApp
          </a>
          <p class="mt-4 border-t border-[var(--color-line)] pt-3 text-xs text-[var(--color-gray-soft)]">
            {SITE.address}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- INCLUDES + CERTIFICATE -->
  <section class="bg-[var(--color-cream)] py-20">
    <div class="container-px mx-auto max-w-6xl">
      <div class="grid gap-10 md:grid-cols-2">
        <div class="card">
          <span class="eyebrow">Qué incluye</span>
          <h3 class="mt-4 font-display text-xl font-bold">Todo viene con tu inscripción</h3>
          <ul class="mt-5 space-y-3">
            {c.includes.es.map((it) => (
              <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
                <span class="mt-0.5 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-gradient-to-br from-[var(--color-gold-400)] to-[var(--color-gold-300)] text-[#4a3210]">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                {it}
              </li>
            ))}
          </ul>
        </div>

        <div class="card text-center">
          <span class="eyebrow eyebrow-gold">Certificación</span>
          <div class="mt-6 grid place-items-center">
            <div class="grid h-20 w-20 place-items-center rounded-full bg-gradient-to-br from-[var(--color-gold-400)] to-[var(--color-gold-300)] text-[#4a3210] shadow-lg">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="6"/>
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
              </svg>
            </div>
          </div>
          <h3 class="mt-5 font-display text-xl font-bold">Certificado oficial Mia's Aesthetics</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-gray-soft)]">{c.certificate.es}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OTHER COURSES -->
  <section class="bg-white py-20">
    <div class="container-px mx-auto max-w-6xl">
      <h2 class="h-display text-2xl sm:text-3xl">Otros cursos</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {others.map((o) => {
          const op = o.palette;
          return (
            <a href={`/cursos/${o.slugs.es}`} class="card group flex flex-col">
              <div class="h-1.5 w-12 rounded-full" style={`background: linear-gradient(90deg, ${op.from}, ${op.to});`}></div>
              <h3 class="mt-4 font-display text-lg font-bold group-hover:text-[var(--color-pink-700)]">{o.title.es}</h3>
              <p class="mt-2 flex-1 text-sm text-[var(--color-gray-soft)]">{o.shortDesc.es}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-[var(--color-pink-600)] group-hover:gap-2">
                Ver más →
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>
