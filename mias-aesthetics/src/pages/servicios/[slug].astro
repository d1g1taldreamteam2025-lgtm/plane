---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceMedia from "../../components/ServiceMedia.astro";
import { t, getDict } from "../../i18n";
import { waLink, SITE } from "../../lib/site.ts";
import { SERVICES, findServiceBySlug } from "../../data/services.ts";
import type { ServiceTag } from "../../data/reels.ts";

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slugs.es }, props: { id: s.id } }));
}

const { slug } = Astro.params;
const lang = "es" as const;
const svc = findServiceBySlug(slug!, lang)!;
const p = svc.palette;

const waHref = waLink(`Hola Mia's Aesthetics, quisiera info sobre ${svc.title.es}.`);

const others = SERVICES.filter((s) => s.id !== svc.id).slice(0, 3);
const previewItems = getDict(lang).services_preview.items;

const pageUrl = `${SITE.url}/servicios/${slug}`;

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: svc.title.es,
  name: svc.title.es,
  description: svc.shortDesc.es + " " + svc.longDesc.es[0],
  provider: { "@id": `${SITE.url}/#business` },
  areaServed: { "@type": "City", name: "Anaheim" },
  url: pageUrl,
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    price: svc.priceFrom.es.match(/\$?[\d,]+/)?.[0]?.replace(/[^\d.]/g, "") ?? undefined,
    priceSpecification: { "@type": "PriceSpecification", priceCurrency: "USD", price: svc.priceFrom.es },
    availability: "https://schema.org/InStock",
    url: pageUrl,
  },
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio",     item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Servicios",  item: `${SITE.url}/#services` },
    { "@type": "ListItem", position: 3, name: svc.title.es, item: pageUrl },
  ],
};
const faqJsonLd = svc.faqs.es.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: svc.faqs.es.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;
const extraJsonLd = [serviceJsonLd, breadcrumbJsonLd, faqJsonLd].filter(Boolean) as object[];
---
<MainLayout
  lang={lang}
  path={`/servicios/${slug}`}
  title={`${svc.title.es} en Anaheim, CA — Mia's Aesthetics`}
  description={svc.shortDesc.es}
  showWelcomeModal={false}
  extraJsonLd={extraJsonLd}
>
  <!-- HERO -->
  <section
    class="relative overflow-hidden py-20 sm:py-28"
    style={`background: linear-gradient(135deg, ${p.from} 0%, ${p.to} 100%);`}
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-32 -left-20 h-[440px] w-[440px] rounded-full bg-white opacity-30 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 h-[480px] w-[480px] rounded-full bg-white opacity-25 blur-3xl"></div>
      <span class="twinkle absolute top-[20%] left-[10%] h-2 w-2 rounded-full bg-white"></span>
      <span class="twinkle absolute bottom-[18%] right-[12%] h-3 w-3 rounded-full bg-white" style="animation-delay:0.8s"></span>
    </div>

    <div class="container-px relative mx-auto max-w-7xl" style={`color: ${p.text};`}>
      <nav class="text-xs uppercase tracking-widest opacity-80" aria-label="breadcrumb">
        <a href="/" class="hover:opacity-100">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/#services" class="hover:opacity-100">Servicios</a>
        <span class="mx-2">/</span>
        <span class="opacity-100">{svc.title.es}</span>
      </nav>

      <div class="mt-8 grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="inline-block rounded-full bg-white/20 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest backdrop-blur">
            {t(lang, "services_preview.eyebrow")}
          </span>
          <h1 class="h-display mt-5 text-[clamp(2rem,7vw,4.5rem)]" style={`color: ${p.text};`}>
            {svc.title.es}
          </h1>
          <p class="mt-5 max-w-2xl text-base opacity-90 sm:text-lg lg:text-xl">{svc.tagline.es}</p>

          <div class="mt-8 flex flex-wrap items-center gap-4 text-sm font-semibold">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
              {svc.duration.es}
            </span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              {svc.priceFrom.es}
            </span>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp">
              <img src={SITE.icons.whatsapp} alt="" width="18" height="18" class="h-[18px] w-[18px]" loading="lazy"/>
              Reservar por WhatsApp
            </a>
            <a href="/#services" class="btn !bg-white/20 !text-white hover:!bg-white hover:!text-[var(--color-ink)]">← Otros servicios</a>
          </div>
        </div>

        <!-- Visual placeholder -->
        <div class="hidden lg:col-span-5 lg:block">
          <div class="float-y mx-auto aspect-square w-full max-w-md rounded-3xl border border-white/30 bg-white/15 p-8 backdrop-blur">
            <div class="grid h-full place-items-center rounded-2xl border-2 border-dashed border-white/40">
              <div class="text-center">
                <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="mx-auto opacity-80" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <p class="mt-4 text-xs uppercase tracking-widest opacity-90">Foto próximamente</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LONG DESCRIPTION + INCLUDES -->
  <section class="bg-white py-20">
    <div class="container-px mx-auto grid max-w-6xl gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <span class="eyebrow">Sobre el tratamiento</span>
        <h2 class="h-display mt-5 text-[clamp(1.75rem,3.5vw,2.5rem)]">{svc.shortDesc.es}</h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-gray-soft)]">
          {svc.longDesc.es.map((para) => <p>{para}</p>)}
        </div>

        <h3 class="mt-12 font-display text-xl font-bold">¿Qué incluye?</h3>
        <ul class="mt-5 space-y-3">
          {svc.includes.es.map((it) => (
            <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
              <span class="mt-0.5 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-gradient-to-br from-[var(--color-pink-500)] to-[var(--color-blush-400)] text-white">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {it}
            </li>
          ))}
        </ul>
      </div>

      <!-- BOOKING ASIDE -->
      <aside class="self-start lg:sticky lg:top-28">
        <div class="rounded-3xl border border-[var(--color-line)] bg-gradient-to-br from-[var(--color-blush-50)] to-white p-6 shadow-md">
          <span class="eyebrow eyebrow-gold">Reservá</span>
          <h3 class="mt-3 font-display text-lg font-bold">Tu cita en Anaheim</h3>
          <ul class="mt-5 space-y-3 text-sm">
            <li class="flex items-center justify-between border-b border-[var(--color-line)] pb-3">
              <span class="text-[var(--color-gray-soft)]">Duración</span>
              <span class="font-semibold">{svc.duration.es}</span>
            </li>
            <li class="flex items-center justify-between border-b border-[var(--color-line)] pb-3">
              <span class="text-[var(--color-gray-soft)]">Precio</span>
              <span class="font-semibold">{svc.priceFrom.es}</span>
            </li>
            <li class="text-xs leading-snug text-[var(--color-gray-soft)]">{svc.priceNote.es}</li>
          </ul>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp mt-5 w-full">
            Reservar por WhatsApp
          </a>
          <p class="mt-4 border-t border-[var(--color-line)] pt-3 text-xs text-[var(--color-gray-soft)]">
            {SITE.address}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <ServiceMedia lang={lang} service={svc.id as ServiceTag} withVisuals={svc.id === "iv"} />

  <!-- PRE / POST CARE -->
  <section class="bg-[var(--color-cream)] py-20">
    <div class="container-px mx-auto max-w-6xl">
      <div class="text-center">
        <span class="eyebrow">Cuidados</span>
        <h2 class="h-display mt-5 text-[clamp(1.75rem,3.5vw,2.5rem)]">Antes y después</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-[var(--color-blush-100)] text-[var(--color-pink-600)]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold">Antes del tratamiento</h3>
          </div>
          <ul class="mt-5 space-y-3">
            {svc.preCare.es.map((it) => (
              <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-pink-500)]"></span>
                {it}
              </li>
            ))}
          </ul>
        </div>
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-[var(--color-blush-100)] text-[var(--color-pink-600)]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold">Después del tratamiento</h3>
          </div>
          <ul class="mt-5 space-y-3">
            {svc.postCare.es.map((it) => (
              <li class="flex items-start gap-3 text-sm text-[var(--color-graphite)]">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-pink-500)]"></span>
                {it}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {svc.faqs.es.length > 0 && (
    <section class="bg-white py-20">
      <div class="container-px mx-auto max-w-3xl">
        <div class="text-center">
          <span class="eyebrow eyebrow-gold">Preguntas frecuentes</span>
          <h2 class="h-display mt-5 text-[clamp(1.75rem,3.5vw,2.5rem)]">Lo que más nos preguntan</h2>
        </div>
        <div class="mt-10 space-y-3">
          {svc.faqs.es.map((faq) => (
            <details class="group rounded-2xl border border-[var(--color-line)] bg-white p-5 transition hover:shadow-md">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-display font-semibold">
                {faq.q}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" class="text-[var(--color-pink-600)] transition group-open:rotate-45">
                  <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-gray-soft)]">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- OTHER SERVICES -->
  <section class="bg-[var(--color-cream)] py-20">
    <div class="container-px mx-auto max-w-6xl">
      <h2 class="h-display text-2xl sm:text-3xl">Otros servicios</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {others.map((o) => {
          const op = o.palette;
          return (
            <a href={`/servicios/${o.slugs.es}`} class="card group flex flex-col">
              <div
                class="h-1.5 w-12 rounded-full"
                style={`background: linear-gradient(90deg, ${op.from}, ${op.to});`}
              ></div>
              <h3 class="mt-4 font-display text-lg font-bold group-hover:text-[var(--color-pink-700)]">{o.title.es}</h3>
              <p class="mt-2 flex-1 text-sm text-[var(--color-gray-soft)]">{o.shortDesc.es}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-[var(--color-pink-600)] group-hover:gap-2">
                Ver más →
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>
